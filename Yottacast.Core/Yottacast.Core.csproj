<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
<PackageReference Include="Jint" Version="3.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <!-- Download math.js on first build if not already present -->
  <Target Name="DownloadMathJs" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(MSBuildThisFileDirectory)Search/Calculator" />
    <Exec
      Command="curl -fsSL https://cdnjs.cloudflare.com/ajax/libs/mathjs/11.12.0/math.min.js -o &quot;$(MSBuildThisFileDirectory)Search/Calculator/math.min.js&quot;"
      Condition="!Exists('$(MSBuildThisFileDirectory)Search/Calculator/math.min.js')" />
  </Target>

  <!-- Download emoji data on first build if not already present -->
  <!-- To update to a newer version: delete Search/Emoji/emoji-data.json and rebuild -->
  <Target Name="DownloadEmojiData" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(MSBuildThisFileDirectory)Search/Emoji" />
    <Exec
      Command="curl -fsSL https://raw.githubusercontent.com/iamcal/emoji-data/refs/heads/master/emoji.json -o &quot;$(MSBuildThisFileDirectory)Search/Emoji/emoji-data.json&quot;"
      Condition="!Exists('$(MSBuildThisFileDirectory)Search/Emoji/emoji-data.json')" />
  </Target>

  <!-- Copy the compact emoji cache from AppData into the source tree if available but not yet present. -->
  <!-- Run the app once to generate the cache, then rebuild to embed it. -->
  <!-- To regenerate: delete Search/Emoji/emoji-cache.json and rebuild (app will recreate it on next run). -->
  <PropertyGroup>
    <_EmojiCacheSrc Condition="$([MSBuild]::IsOsPlatform('OSX'))">$(HOME)/Library/Application Support/Yottacast/emoji-cache.json</_EmojiCacheSrc>
    <_EmojiCacheSrc Condition="$([MSBuild]::IsOsPlatform('Windows'))">$(APPDATA)\Yottacast\emoji-cache.json</_EmojiCacheSrc>
    <_EmojiCacheSrc Condition="$([MSBuild]::IsOsPlatform('Linux'))">$(HOME)/.config/Yottacast/emoji-cache.json</_EmojiCacheSrc>
    <_EmojiCacheDst>$(MSBuildThisFileDirectory)Search/Emoji/emoji-cache.json</_EmojiCacheDst>
  </PropertyGroup>
  <Target Name="CopyEmojiCache" BeforeTargets="BeforeBuild">
    <Copy
      SourceFiles="$(_EmojiCacheSrc)"
      DestinationFiles="$(_EmojiCacheDst)"
      Condition="'$(_EmojiCacheSrc)' != '' And Exists('$(_EmojiCacheSrc)') And !Exists('$(_EmojiCacheDst)')"
      ContinueOnError="true" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Search/Emoji/emoji-cache.json" Condition="Exists('Search/Emoji/emoji-cache.json')" />
    <EmbeddedResource Include="Search/Emoji/emoji-data.json" Condition="Exists('Search/Emoji/emoji-data.json')" />
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Yottacast.Core.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
