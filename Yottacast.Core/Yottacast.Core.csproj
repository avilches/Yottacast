<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
<PackageReference Include="Jint" Version="3.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <!-- Download math.js on first build if not already present -->
  <Target Name="DownloadMathJs" BeforeTargets="BeforeBuild">
    <MakeDir Directories="$(MSBuildThisFileDirectory)Scripts" />
    <Exec
      Command="curl -fsSL https://cdnjs.cloudflare.com/ajax/libs/mathjs/11.12.0/math.min.js -o &quot;$(MSBuildThisFileDirectory)Scripts/math.min.js&quot;"
      Condition="!Exists('$(MSBuildThisFileDirectory)Scripts/math.min.js')" />
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Scripts/math.min.js" Condition="Exists('Scripts/math.min.js')" />
    <EmbeddedResource Include="Resources/emojis.json" />
  </ItemGroup>

</Project>
