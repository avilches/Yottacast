<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yottacast.ViewModels"
        xmlns:conv="using:Yottacast.Converters"
        xmlns:viewModels="clr-namespace:Yottacast.Core.ViewModels;assembly=Yottacast.Core"
        xmlns:results="using:Yottacast.Views.Results"
        x:Class="Yottacast.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Title="Yottacast"
        Width="{DynamicResource Theme.WindowWidth}"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="False"
        ShowInTaskbar="False">

    <Window.Resources>
        <conv:PathToAppIconConverter x:Key="PathToAppIcon"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Strip all default TextBox chrome -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BoxShadow" Value="none"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BoxShadow" Value="none"/>
        </Style>
        <!-- Placeholder text -->
        <Style Selector="TextBox /template/ TextBlock[Name=PART_Watermark]">
            <Setter Property="Foreground" Value="{DynamicResource Theme.SearchPlaceholder}"/>
        </Style>
        <!-- Spinner pulse animation -->
        <Style Selector="Ellipse.spinner">
            <Style.Animations>
                <Animation Duration="0:0:0.7" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ListBox chrome -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.CornerRadiusItem}"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Theme.ItemSelection}"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Theme.ItemSelection}"/>
        </Style>
        <!-- Keep text visible on selection -->
        <Style Selector="ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ItemSelectionText}"/>
        </Style>
        <!-- Emoji cell selection highlight -->
        <Style Selector="Border.emoji-selected">
            <Setter Property="Background" Value="{DynamicResource Theme.ItemSelectionIconBackground}"/>
        </Style>
        <!-- Conversion cell selection highlight -->
        <Style Selector="Border.conv-cell-selected">
            <Setter Property="Background" Value="{DynamicResource Theme.ItemSelectionIconBackground}"/>
        </Style>
    </Window.Styles>

    <Border Margin="28"
            CornerRadius="{DynamicResource Theme.CornerRadiusWindow}"
            Background="{DynamicResource Theme.WindowBackground}">
        <DockPanel>

            <!-- ── Search row + hint ── -->
            <StackPanel DockPanel.Dock="Top">
                <Grid ColumnDefinitions="*,Auto"
                      Margin="18,0"
                      Height="64">

                    <!-- Search input -->
                    <TextBox Grid.Column="0"
                             x:Name="SearchBox"
                             Text="{Binding SearchText}"
                             Watermark="Search for apps, files, commands…"
                             FontSize="{DynamicResource Theme.FontSizeSearch}"
                             FontWeight="Regular"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource Theme.SearchText}"
                             CaretBrush="{DynamicResource Theme.SearchCaret}"
                             SelectionBrush="{DynamicResource Theme.SearchSelection}">
                        <!-- Override Fluent theme resources so background stays transparent in all states -->
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                        </TextBox.Resources>
                    </TextBox>

                    <!-- Right side: spinner while searching, ESC badge when idle and empty -->
                    <Panel Grid.Column="1" VerticalAlignment="Center">

                        <!-- ESC badge (visible only when text is empty and not searching) -->
                        <Border Background="{DynamicResource Theme.EscBadgeBackground}"
                                CornerRadius="{DynamicResource Theme.CornerRadiusEsc}"
                                Padding="8,4"
                                IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                            <TextBlock Text="ESC"
                                       Foreground="{DynamicResource Theme.EscBadgeText}"
                                       FontSize="{DynamicResource Theme.FontSizeSmall}"
                                       FontWeight="Medium"/>
                        </Border>

                        <!-- Spinner (visible while deferred search is running) -->
                        <Ellipse Classes="spinner"
                                 Width="16" Height="16"
                                 Fill="{DynamicResource Theme.Icon}"
                                 IsVisible="{Binding IsSearching}"/>
                    </Panel>
                </Grid>

                <!-- Error hint (shown below the input when calculator detects an actionable error) -->
                <TextBlock Text="{Binding SearchHint}"
                           Foreground="#FF3B30"
                           FontSize="{DynamicResource Theme.FontSizeSmall}"
                           Margin="18,0,18,8"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding SearchHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>

            <!-- ── Divider ── -->
            <Rectangle DockPanel.Dock="Top"
                       Height="1"
                       Fill="{DynamicResource Theme.Divider}"
                       IsVisible="{Binding HasResults}"/>

            <!-- ── No results ── -->
            <Border DockPanel.Dock="Top"
                    Padding="0,28,0,28"
                    IsVisible="{Binding ShowNoResults}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="No results"
                               Foreground="{DynamicResource Theme.NoResultsTitle}"
                               FontSize="{DynamicResource Theme.FontSizeNoResults}"
                               FontWeight="Medium"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Try a different search term"
                               Foreground="{DynamicResource Theme.NoResultsSubtitle}"
                               FontSize="{DynamicResource Theme.FontSizeTitle}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ── Results list ── -->
            <ListBox DockPanel.Dock="Top"
                     x:Name="ResultsList"
                     ItemsSource="{Binding Results}"
                     SelectedItem="{Binding SelectedResult}"
                     MaxHeight="416"
                     Padding="8,6"
                     IsVisible="{Binding HasResults}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.DataTemplates>
                    <!-- Template for emoji grid (more specific type first) -->
                    <DataTemplate x:DataType="viewModels:EmojiGridResultViewModel">
                        <results:EmojiGridResultView/>
                    </DataTemplate>

                    <!-- Calculator template (title + subtitle, no icon/category) -->
                    <DataTemplate x:DataType="viewModels:CalculatorResultItemViewModel">
                        <results:CalculatorResultItemView/>
                    </DataTemplate>

                    <!-- Conversion template (two-column from → to layout) -->
                    <DataTemplate x:DataType="viewModels:ConversionResultItemViewModel">
                        <results:ConversionResultItemView/>
                    </DataTemplate>

                    <!-- Standard template (apps, files, etc.) -->
                    <DataTemplate x:DataType="viewModels:ResultItemViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="44">

                            <!-- Icon box (with optional badge overlay) -->
                            <Grid Grid.Column="0"
                                  Width="40" Height="40"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0">

                                <Border Classes="icon-box"
                                        CornerRadius="{DynamicResource Theme.CornerRadiusIcon}"
                                        ClipToBounds="True">
                                    <Image IsVisible="{Binding IconBytes, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           Source="{Binding IconBytes, Converter={StaticResource PathToAppIcon}}"
                                           Width="40" Height="40"
                                           Stretch="UniformToFill"
                                           RenderOptions.BitmapInterpolationMode="HighQuality"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>

                                <!-- Default-app badge: bottom-right corner, 7px overflow + 2px ring -->
                                <Border Width="18" Height="18"
                                        CornerRadius="5"
                                        Background="{DynamicResource Theme.Background}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,-7,-7"
                                        IsVisible="{Binding BadgeIconBytes, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Border Width="14" Height="14"
                                            CornerRadius="4"
                                            ClipToBounds="True">
                                        <Image Source="{Binding BadgeIconBytes, Converter={StaticResource PathToAppIcon}}"
                                               Width="14" Height="14"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                    </Border>
                                </Border>
                            </Grid>

                            <!-- Title + subtitle -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Vertical"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="{Binding Title}"
                                           Foreground="{DynamicResource Theme.ItemTitle}"
                                           FontSize="{DynamicResource Theme.FontSizeTitle}"
                                           FontWeight="Medium"/>
                                <TextBlock Text="{Binding Subtitle}"
                                           Foreground="{DynamicResource Theme.ItemSubtitle}"
                                           FontSize="{DynamicResource Theme.FontSizeSubtitle}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <!-- Category (normal) / Score (alt-debug) + shortcut -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Spacing="8"
                                        Margin="12,0,0,0">
                                <!-- Normal mode: category label -->
                                <TextBlock x:CompileBindings="False"
                                           Text="{Binding Category}"
                                           Foreground="{DynamicResource Theme.ItemCategory}"
                                           FontSize="{DynamicResource Theme.FontSizeSmall}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding !DataContext.IsAltPressed, ElementName=RootWindow}"/>
                                <!-- Alt debug mode: score -->
                                <TextBlock x:CompileBindings="False"
                                           Text="{Binding Score, StringFormat={}{0:F2}}"
                                           Foreground="{DynamicResource Theme.ItemCategory}"
                                           FontSize="{DynamicResource Theme.FontSizeSmall}"
                                           VerticalAlignment="Center"
                                           IsVisible="{Binding DataContext.IsAltPressed, ElementName=RootWindow}"/>
                                <Border Background="{DynamicResource Theme.ItemShortcutBackground}"
                                        CornerRadius="{DynamicResource Theme.CornerRadiusShortcut}"
                                        Padding="7,3"
                                        IsVisible="{Binding Shortcut, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding Shortcut}"
                                               Foreground="{DynamicResource Theme.ItemShortcutText}"
                                               FontSize="{DynamicResource Theme.FontSizeSmall}"/>
                                </Border>
                            </StackPanel>

                        </Grid>
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>

            <!-- ── Update banner ── -->
            <Button DockPanel.Dock="Bottom"
                    Command="{Binding UpdateBannerClickCommand}"
                    IsVisible="{Binding UpdateAvailable}"
                    Background="{DynamicResource Theme.ItemSelection}"
                    BorderThickness="0"
                    Padding="18,9"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Cursor="Hand">
                <TextBlock Text="{Binding UpdateBannerText}"
                           Foreground="{DynamicResource Theme.ItemText}"
                           FontSize="{DynamicResource Theme.FontSizeSmall}"
                           FontWeight="Medium"
                           HorizontalAlignment="Center"/>
            </Button>

            <!-- ── Footer ── -->
            <Border DockPanel.Dock="Bottom"
                    Padding="18,7"
                    BorderBrush="{DynamicResource Theme.FooterBorder}"
                    BorderThickness="0,1,0,0"
                    IsVisible="{Binding HasResults}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <TextBlock Foreground="{DynamicResource Theme.FooterText}"
                                   FontSize="{DynamicResource Theme.FontSizeSmall}">
                            <Run Text="{Binding Results.Count}"/>
                            <Run Text="results"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="↑↓  navigate"  Foreground="{DynamicResource Theme.FooterText}" FontSize="{DynamicResource Theme.FontSizeSmall}"/>
                        <TextBlock Text="↵  open"        Foreground="{DynamicResource Theme.FooterText}" FontSize="{DynamicResource Theme.FontSizeSmall}"/>
                    </StackPanel>
                </Grid>
            </Border>

        </DockPanel>
    </Border>

</Window>
