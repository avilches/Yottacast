<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yottacast.ViewModels"
        xmlns:conv="using:Yottacast.Converters"
        xmlns:viewModels="clr-namespace:Yottacast.Core.ViewModels;assembly=Yottacast.Core"
        xmlns:results="using:Yottacast.Views.Results"
        x:Class="Yottacast.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="RootWindow"
        Title="Yottacast"
        Width="{DynamicResource Theme.Window.Width}"
        SizeToContent="Height"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        RenderOptions.TextRenderingMode="Antialias">

    <Window.Resources>
        <conv:PathToAppIconConverter x:Key="PathToAppIcon"/>
    </Window.Resources>

    <Window.Styles>
        <!-- Strip all default TextBox chrome -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BoxShadow" Value="none"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BoxShadow" Value="none"/>
        </Style>
        <!-- Placeholder text -->
        <Style Selector="TextBox /template/ TextBlock[Name=PART_Watermark]">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Search.Placeholder}"/>
        </Style>
        <!-- Spinner pulse animation -->
        <Style Selector="Ellipse.spinner">
            <Style.Animations>
                <Animation Duration="0:0:0.7" IterationCount="INFINITE" PlaybackDirection="Alternate">
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- ListBox chrome -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Results.CornerRadius}"/>
            <Setter Property="MinHeight" Value="52"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Theme.Results.Selection.Background}"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Theme.Results.Selection.Background}"/>
        </Style>
        <!-- Keep text visible on selection -->
        <Style Selector="ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Results.Selection.Color}"/>
        </Style>
        <!-- Options menu ListBoxItems: compact, themed -->
        <Style Selector="ListBox.menu-list ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="{DynamicResource Theme.Menu.Option.Padding}"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Menu.Option.CornerRadius}"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>
        <Style Selector="ListBox.menu-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Theme.Menu.OptionSelected.Background}"/>
        </Style>
        <Style Selector="ListBox.menu-list ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Menu.OptionSelected.Color}"/>
        </Style>

        <!-- Dictionary pills keep category color when selected -->
        <Style Selector="ListBoxItem:selected TextBlock.dict-pill">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Results.Category.Color}"/>
        </Style>
        <!-- Emoji ListBoxItem: no selection background (only the individual cell gets highlighted) -->
        <Style Selector="ListBoxItem.emoji-item:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem.emoji-item:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Emoji cell selection highlight: only when the ListBoxItem is selected -->
        <Style Selector="ListBoxItem:selected Border.emoji-selected">
            <Setter Property="Background" Value="{DynamicResource Theme.Results.Selection.Background}"/>
        </Style>
        <!-- Emoji placeholder cell: invisible spacer to pad sections to full rows -->
        <Style Selector="Border.emoji-placeholder">
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <!-- Conversion with navigable cells: suppress ListBoxItem selection background -->
        <Style Selector="ListBoxItem.conv-navigable:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem.conv-navigable:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Conversion cell selection highlight: only when the ListBoxItem is selected -->
        <Style Selector="ListBoxItem:selected Border.conv-cell-selected">
            <Setter Property="Background" Value="{DynamicResource Theme.Results.Selection.Background}"/>
        </Style>
        <!-- Selection bar: left accent on selected standard items (not emoji/conv which have cell selection) -->
        <!-- ContentPadding compensates for the bar width so content doesn't shift right -->
        <Style Selector="ListBoxItem:selected:not(.emoji-item):not(.conv-navigable)">
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Results.SelectionBar.Color}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource Theme.Results.SelectionBar.Thickness}"/>
            <Setter Property="Padding" Value="{DynamicResource Theme.Results.SelectionBar.ContentPadding}"/>
        </Style>
    </Window.Styles>

    <Border Margin="28"
            CornerRadius="{DynamicResource Theme.Window.CornerRadius}"
            Background="{DynamicResource Theme.Window.Background}"
            TextElement.FontFamily="{DynamicResource Theme.Window.FontFamily}"
            PointerPressed="OnRootPointerPressed">
        <DockPanel>

            <!-- ── Search row + hint ── -->
            <!-- StackPanel is transparent: window.background colors this header zone -->
            <!-- ZIndex="5" allows the hint overlay to float over sibling DockPanel children -->
            <StackPanel DockPanel.Dock="Top" ZIndex="5">

                <!-- Input box + hint overlay (hint floats over the bottom of the input, no layout shift) -->
                <Grid>
                    <Border Background="{DynamicResource Theme.Search.Background}"
                            CornerRadius="{DynamicResource Theme.Search.Input.CornerRadius}"
                            Margin="{DynamicResource Theme.Search.Input.Margin}"
                            Padding="{DynamicResource Theme.Search.Input.Padding}"
                            BorderBrush="{DynamicResource Theme.Search.Input.BorderColor}"
                            BorderThickness="{DynamicResource Theme.Search.Input.BorderThickness}">
                        <Grid ColumnDefinitions="*,Auto"
                              MinHeight="46">

                            <!-- Search input -->
                            <TextBox Grid.Column="0"
                                     x:Name="SearchBox"
                                     Text="{Binding SearchText}"
                                     Watermark="Search for apps, files, commands…"
                                     FontFamily="{DynamicResource Theme.Search.FontFamily}"
                                     FontSize="{DynamicResource Theme.Search.Size}"
                                     FontWeight="Regular"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Foreground="{DynamicResource Theme.Search.Color}"
                                     CaretBrush="{DynamicResource Theme.Search.Caret}"
                                     SelectionBrush="{DynamicResource Theme.Search.Selection}">
                                <!-- Override Fluent theme resources so background stays transparent in all states -->
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
                                </TextBox.Resources>
                            </TextBox>

                            <!-- Right side: spinner while deferred search is running -->
                            <Ellipse Grid.Column="1"
                                     Classes="spinner"
                                     Width="16" Height="16"
                                     Margin="0,0,14,0"
                                     Fill="{DynamicResource Theme.Spinner.Color}"
                                     IsVisible="{Binding IsSearching}"/>
                        </Grid>
                    </Border>

                    <!-- Info hint — position and style fully controlled by theme -->
                    <Grid VerticalAlignment="Bottom"
                          Margin="{DynamicResource Theme.Search.Hint.Info.Margin}"
                          IsHitTestVisible="False">
                        <Border HorizontalAlignment="{DynamicResource Theme.Search.Hint.Info.HorizontalAlignment}"
                                Background="{DynamicResource Theme.Search.Hint.Info.Background}"
                                Padding="{DynamicResource Theme.Search.Hint.Info.Padding}"
                                CornerRadius="{DynamicResource Theme.Search.Hint.Info.CornerRadius}"
                                Opacity="0"
                                IsVisible="{Binding SearchHintIsInfo}">
                            <Border.Styles>
                                <Style Selector="Border[IsVisible=true]">
                                    <Style.Animations>
                                        <Animation Duration="0:0:0.4" FillMode="Forward">
                                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Border.Styles>
                            <TextBlock Text="{Binding SearchHint}"
                                       Foreground="{DynamicResource Theme.Search.Hint.Info.Color}"
                                       FontSize="{DynamicResource Theme.Search.Hint.Info.Size}"
                                       FontFamily="{DynamicResource Theme.Search.Hint.Info.FontFamily}"
                                       TextAlignment="{DynamicResource Theme.Search.Hint.Info.TextAlignment}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Grid>
                    <!-- Error hint — position and style fully controlled by theme -->
                    <Grid VerticalAlignment="Bottom"
                          Margin="{DynamicResource Theme.Search.Hint.Error.Margin}"
                          IsHitTestVisible="False">
                        <Border HorizontalAlignment="{DynamicResource Theme.Search.Hint.Error.HorizontalAlignment}"
                                Background="{DynamicResource Theme.Search.Hint.Error.Background}"
                                Padding="{DynamicResource Theme.Search.Hint.Error.Padding}"
                                CornerRadius="{DynamicResource Theme.Search.Hint.Error.CornerRadius}"
                                Opacity="0"
                                IsVisible="{Binding SearchHintIsError}">
                            <Border.Styles>
                                <Style Selector="Border[IsVisible=true]">
                                    <Style.Animations>
                                        <Animation Duration="0:0:0.4" FillMode="Forward">
                                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
                                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Border.Styles>
                            <TextBlock Text="{Binding SearchHint}"
                                       Foreground="{DynamicResource Theme.Search.Hint.Error.Color}"
                                       FontSize="{DynamicResource Theme.Search.Hint.Error.Size}"
                                       FontFamily="{DynamicResource Theme.Search.Hint.Error.FontFamily}"
                                       TextAlignment="{DynamicResource Theme.Search.Hint.Error.TextAlignment}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Grid>
                </Grid>
            </StackPanel>

            <!-- ── Divider ── -->
            <Rectangle DockPanel.Dock="Top"
                       Height="1"
                       Fill="{DynamicResource Theme.Divider.Color}"
                       IsVisible="{Binding HasResults}"/>

            <!-- ── No results ── -->
            <Border DockPanel.Dock="Top"
                    Padding="0,28,0,28"
                    Background="{DynamicResource Theme.Results.Background}"
                    IsVisible="{Binding ShowNoResults}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="No results"
                               Foreground="{DynamicResource Theme.NoResults.Title.Color}"
                               FontSize="{DynamicResource Theme.NoResults.Title.Size}"
                               FontWeight="Medium"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Try a different search term"
                               Foreground="{DynamicResource Theme.NoResults.Subtitle.Color}"
                               FontSize="{DynamicResource Theme.NoResults.Subtitle.Size}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ── Results list + Options overlay ── -->
            <Panel DockPanel.Dock="Top" x:Name="ResultsPanel">

                <ListBox x:Name="ResultsList"
                         ItemsSource="{Binding Results}"
                         SelectedItem="{Binding SelectedResult}"
                         MaxHeight="{DynamicResource Theme.Results.MaxHeight}"
                         Padding="{DynamicResource Theme.Results.Padding}"
                         Background="{DynamicResource Theme.Results.Background}"
                         IsVisible="{Binding HasResults}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.AllowAutoHide="True">
                    <ListBox.DataTemplates>
                        <!-- Template for emoji grid (more specific type first) -->
                        <DataTemplate x:DataType="viewModels:EmojiGridResultViewModel">
                            <results:EmojiGridResultView/>
                        </DataTemplate>

                        <!-- Calculator template (title + subtitle, no icon/category) -->
                        <DataTemplate x:DataType="viewModels:CalculatorResultItemViewModel">
                            <results:CalculatorResultItemView/>
                        </DataTemplate>

                        <!-- Conversion template (two-column from → to layout) -->
                        <DataTemplate x:DataType="viewModels:ConversionResultItemViewModel">
                            <results:ConversionResultItemView/>
                        </DataTemplate>

                        <!-- Dictionary template (word + PoS pill + definition + example) -->
                        <DataTemplate x:DataType="viewModels:DictionaryResultViewModel">
                            <results:DictionaryResultItemView/>
                        </DataTemplate>

                        <!-- Standard template (apps, files, etc.) -->
                        <DataTemplate x:DataType="viewModels:ResultItemViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="44">

                                <!-- Icon box (with optional badge overlay) -->
                                <Grid Grid.Column="0"
                                      Width="40" Height="40"
                                      VerticalAlignment="Center"
                                      Margin="0,0,12,0">

                                    <Border Classes="icon-box"
                                            CornerRadius="{DynamicResource Theme.Results.Icon.CornerRadius}"
                                            ClipToBounds="True">
                                        <Image IsVisible="{Binding IconBytes, Converter={x:Static ObjectConverters.IsNotNull}}"
                                               Source="{Binding IconBytes, Converter={StaticResource PathToAppIcon}}"
                                               Width="40" Height="40"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapInterpolationMode="HighQuality"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Default-app badge: bottom-right corner, 7px overflow + 2px ring -->
                                    <Border Width="18" Height="18"
                                            CornerRadius="5"
                                            Background="{DynamicResource Theme.Window.Background}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,-7,-7"
                                            IsVisible="{Binding BadgeIconBytes, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Border Width="14" Height="14"
                                                CornerRadius="4"
                                                ClipToBounds="True">
                                            <Image Source="{Binding BadgeIconBytes, Converter={StaticResource PathToAppIcon}}"
                                                   Width="14" Height="14"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                        </Border>
                                    </Border>
                                </Grid>

                                <!-- Title + subtitle -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Vertical"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="{DynamicResource Theme.Results.Title.Color}"
                                               FontSize="{DynamicResource Theme.Results.Title.Size}"
                                               FontWeight="Medium"/>
                                    <TextBlock Text="{Binding Subtitle}"
                                               Foreground="{DynamicResource Theme.Results.Subtitle.Color}"
                                               FontSize="{DynamicResource Theme.Results.Subtitle.Size}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Category (normal) / Score (alt-debug) + shortcut -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Spacing="8"
                                            Margin="12,0,0,0">
                                    <!-- Normal mode: category label -->
                                    <TextBlock x:CompileBindings="False"
                                               Text="{Binding Category}"
                                               Foreground="{DynamicResource Theme.Results.Category.Color}"
                                               FontSize="{DynamicResource Theme.Results.Category.Size}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !DataContext.IsAltPressed, ElementName=RootWindow}"/>
                                    <!-- Alt debug mode: score -->
                                    <TextBlock x:CompileBindings="False"
                                               Text="{Binding Score, StringFormat={}{0:F2}}"
                                               Foreground="{DynamicResource Theme.Results.Category.Color}"
                                               FontSize="{DynamicResource Theme.Results.Category.Size}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding DataContext.IsAltPressed, ElementName=RootWindow}"/>
                                    <Border Background="{DynamicResource Theme.Results.Shortcut.Background}"
                                            CornerRadius="{DynamicResource Theme.Results.Shortcut.CornerRadius}"
                                            Padding="7,3"
                                            IsVisible="{Binding Shortcut, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                        <TextBlock Text="{Binding Shortcut}"
                                                   Foreground="{DynamicResource Theme.Results.Shortcut.Color}"
                                                   FontSize="{DynamicResource Theme.Results.Shortcut.Size}"/>
                                    </Border>
                                </StackPanel>

                            </Grid>
                        </DataTemplate>
                    </ListBox.DataTemplates>
                </ListBox>

                <!-- ── Options overlay (Tab) — right-aligned, positioned below selected item ── -->
                <Border x:Name="OptionsMenuOverlay"
                        IsVisible="{Binding IsOptionsMenuOpen}"
                        Background="{DynamicResource Theme.Menu.Background}"
                        BorderBrush="{DynamicResource Theme.Menu.Border.Color}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Theme.Menu.Border.Radius}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        MinWidth="220"
                        Margin="8">

                    <StackPanel>
                        <!-- Header -->
                        <Border Background="{DynamicResource Theme.Menu.Header.Background}"
                                Padding="{DynamicResource Theme.Menu.Header.Padding}"
                                Margin="{DynamicResource Theme.Menu.Header.Margin}">
                            <TextBlock Text="Actions"
                                       Foreground="{DynamicResource Theme.Menu.Header.Color}"
                                       FontSize="{DynamicResource Theme.Menu.Header.Size}"/>
                        </Border>

                        <!-- Options list -->
                        <ListBox Classes="menu-list"
                                 ItemsSource="{Binding OptionsMenuItems}"
                                 SelectedIndex="{Binding OptionsMenuSelectedIndex, Mode=OneWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 IsHitTestVisible="False"
                                 Padding="4,0,4,4">
                            <!-- Override global selection-bar style: menu items must not shift on selection -->
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="{DynamicResource Theme.Menu.Option.Padding}"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:OptionsMenuItemVm">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   Foreground="{DynamicResource Theme.Menu.Option.Color}"
                                                   FontSize="{DynamicResource Theme.Menu.Option.Size}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding FormattedHotkey}"
                                                   Foreground="{DynamicResource Theme.Menu.Header.Color}"
                                                   FontSize="{DynamicResource Theme.Menu.Option.Size}"
                                                   VerticalAlignment="Center"
                                                   Margin="20,0,0,0"
                                                   IsVisible="{Binding FormattedHotkey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

            </Panel>

            <!-- ── Update banner ── -->
            <Button DockPanel.Dock="Bottom"
                    Command="{Binding UpdateBannerClickCommand}"
                    IsVisible="{Binding UpdateAvailable}"
                    Background="{DynamicResource Theme.Update.Background}"
                    BorderThickness="0"
                    Padding="18,9"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Cursor="Hand">
                <TextBlock Text="{Binding UpdateBannerText}"
                           Foreground="{DynamicResource Theme.Update.Color}"
                           FontSize="{DynamicResource Theme.Update.Size}"
                           FontWeight="Medium"
                           HorizontalAlignment="Center"/>
            </Button>

            <!-- ── Footer ── -->
            <Border DockPanel.Dock="Bottom"
                    Padding="18,10"
                    Background="{DynamicResource Theme.Footer.Background}"
                    BorderBrush="{DynamicResource Theme.Footer.Border}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="{DynamicResource Theme.Window.CornerRadius.Bottom}">
                <Grid ColumnDefinitions="Auto,*">
                    <!-- Left: Settings shortcut hint -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding SettingsShortcutText}"
                               Foreground="{DynamicResource Theme.Footer.Color}"
                               FontSize="{DynamicResource Theme.Footer.Size}"
                               VerticalAlignment="Center"/>

                    <!-- Right: dynamic hints -->
                    <ItemsControl Grid.Column="1"
                                  ItemsSource="{Binding FooterHints}"
                                  IsVisible="{Binding HasResults}"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="16"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <TextBlock Text="{Binding}"
                                           Foreground="{DynamicResource Theme.Footer.Color}"
                                           FontSize="{DynamicResource Theme.Footer.Size}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

        </DockPanel>
    </Border>

</Window>
