<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Yottacast.Core.ViewModels;assembly=Yottacast.Core"
             x:Class="Yottacast.Views.Results.ConversionResultItemView"
             x:DataType="viewModels:ConversionResultItemViewModel">
    <Grid ColumnDefinitions="*" RowDefinitions="*,Auto" MinHeight="68"
          TextElement.FontFamily="{DynamicResource Theme.Conv.FontFamily}">

        <!-- 2-cell layout: From → To (when math.js did NOT simplify the from) -->
        <Grid Grid.Row="0" Grid.Column="0"
              IsVisible="{Binding !FromWasNormalized}"
              ColumnDefinitions="*,Auto,*"
              VerticalAlignment="Center"
              Margin="0,8">
            <!-- From -->
            <Border Grid.Column="0" CornerRadius="{DynamicResource Theme.Conv.Cell.CornerRadius}" Padding="6,4"
                    HorizontalAlignment="Stretch">
                <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding FromShort}"
                               Foreground="{DynamicResource Theme.Conv.Value.Color}"
                               FontSize="{DynamicResource Theme.Conv.Value.Size}"
                               FontWeight="Medium"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding FromLong}"
                               Foreground="{DynamicResource Theme.Conv.Subtitle.Color}"
                               FontSize="{DynamicResource Theme.Conv.Subtitle.Size}"
                               Opacity="{DynamicResource Theme.Conv.Subtitle.Opacity}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               IsVisible="{Binding FromLong, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
            </Border>
            <!-- Arrow -->
            <TextBlock Grid.Column="1" Text="→"
                       Foreground="{DynamicResource Theme.Conv.Arrow.Color}"
                       VerticalAlignment="Center"
                       Margin="8,0"/>
            <!-- To -->
            <Border Grid.Column="2" CornerRadius="{DynamicResource Theme.Conv.Cell.CornerRadius}" Padding="6,4"
                    HorizontalAlignment="Stretch"
                    Classes.conv-cell-selected="{Binding IsToHighlighted}">
                <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ToShort}"
                               Foreground="{DynamicResource Theme.Calc.Result.Color}"
                               FontSize="{DynamicResource Theme.Calc.Result.Size}"
                               FontWeight="{DynamicResource Theme.Calc.Result.FontWeight}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding ToLong}"
                               Foreground="{DynamicResource Theme.Conv.Subtitle.Color}"
                               FontSize="{DynamicResource Theme.Conv.Subtitle.Size}"
                               Opacity="{DynamicResource Theme.Conv.Subtitle.Opacity}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               IsVisible="{Binding ToLong, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3-cell layout: OrigFrom → NormFrom → To (when math.js simplified the from) -->
        <Grid Grid.Row="0" Grid.Column="0"
              IsVisible="{Binding FromWasNormalized}"
              ColumnDefinitions="*,Auto,*,Auto,*"
              VerticalAlignment="Center"
              Margin="0,8">
            <!-- OrigFrom (context only, not navigable) -->
            <Border Grid.Column="0" CornerRadius="{DynamicResource Theme.Conv.Cell.CornerRadius}" Padding="6,4"
                    HorizontalAlignment="Stretch">
                <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding FromShort}"
                               Foreground="{DynamicResource Theme.Conv.Value.Color}"
                               FontSize="{DynamicResource Theme.Conv.Value.Size}"
                               FontWeight="Medium"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding FromLong}"
                               Foreground="{DynamicResource Theme.Conv.Subtitle.Color}"
                               FontSize="{DynamicResource Theme.Conv.Subtitle.Size}"
                               Opacity="{DynamicResource Theme.Conv.Subtitle.Opacity}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               IsVisible="{Binding FromLong, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
            </Border>
            <!-- Arrow 1 -->
            <TextBlock Grid.Column="1" Text="→"
                       Foreground="{DynamicResource Theme.Conv.Arrow.Color}"
                       VerticalAlignment="Center"
                       Margin="8,0"/>
            <!-- NormFrom -->
            <Border Grid.Column="2" CornerRadius="{DynamicResource Theme.Conv.Cell.CornerRadius}" Padding="6,4"
                    HorizontalAlignment="Stretch"
                    Classes.conv-cell-selected="{Binding IsNormFromHighlighted}">
                <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding NormFromShort}"
                               Foreground="{DynamicResource Theme.Conv.Value.Color}"
                               FontSize="{DynamicResource Theme.Conv.Value.Size}"
                               FontWeight="Medium"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding NormFromLong}"
                               Foreground="{DynamicResource Theme.Conv.Subtitle.Color}"
                               FontSize="{DynamicResource Theme.Conv.Subtitle.Size}"
                               Opacity="{DynamicResource Theme.Conv.Subtitle.Opacity}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               IsVisible="{Binding NormFromLong, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
            </Border>
            <!-- Arrow 2 -->
            <TextBlock Grid.Column="3" Text="→"
                       Foreground="{DynamicResource Theme.Conv.Arrow.Color}"
                       VerticalAlignment="Center"
                       Margin="8,0"/>
            <!-- To -->
            <Border Grid.Column="4" CornerRadius="{DynamicResource Theme.Conv.Cell.CornerRadius}" Padding="6,4"
                    HorizontalAlignment="Stretch"
                    Classes.conv-cell-selected="{Binding IsToHighlighted}">
                <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding ToShort}"
                               Foreground="{DynamicResource Theme.Calc.Result.Color}"
                               FontSize="{DynamicResource Theme.Calc.Result.Size}"
                               FontWeight="{DynamicResource Theme.Calc.Result.FontWeight}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <TextBlock Text="{Binding ToLong}"
                               Foreground="{DynamicResource Theme.Conv.Subtitle.Color}"
                               FontSize="{DynamicResource Theme.Conv.Subtitle.Size}"
                               Opacity="{DynamicResource Theme.Conv.Subtitle.Opacity}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               IsVisible="{Binding ToLong, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Stale rates indicator -->
        <TextBlock Grid.Row="1"
                   Text="&#x26A0; Exchange rates may be outdated"
                   Foreground="{DynamicResource Theme.Conv.Subtitle.Color}"
                   FontSize="11"
                   Opacity="0.6"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4"
                   IsVisible="{Binding RatesAreStale}"/>

    </Grid>
</UserControl>
