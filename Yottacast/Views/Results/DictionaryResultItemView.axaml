<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Yottacast.Core.ViewModels;assembly=Yottacast.Core"
             xmlns:conv="using:Yottacast.Converters"
             x:Class="Yottacast.Views.Results.DictionaryResultItemView"
             x:DataType="viewModels:DictionaryResultViewModel">
    <UserControl.Resources>
        <conv:PathToAppIconConverter x:Key="PathToAppIcon"/>
    </UserControl.Resources>
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,6,0,6">

        <!-- Wiktionary icon -->
        <Border Grid.Column="0"
                Classes="icon-box"
                Width="28" Height="28"
                CornerRadius="{DynamicResource Theme.Results.Icon.CornerRadius}"
                ClipToBounds="True"
                VerticalAlignment="Top"
                Margin="0,2,12,0">
            <Image IsVisible="{Binding IconBytes, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Source="{Binding IconBytes, Converter={StaticResource PathToAppIcon}}"
                   Width="28" Height="28"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
        </Border>

        <!-- Word + language pill + definitions list -->
        <StackPanel Grid.Column="1"
                    Orientation="Vertical"
                    VerticalAlignment="Top"
                    Spacing="5">

            <!-- Header: word + optional language pill -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="{Binding Word}"
                           Foreground="{DynamicResource Theme.Results.Title.Color}"
                           FontSize="{DynamicResource Theme.Results.Title.Size}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Border Background="{DynamicResource Theme.Results.Shortcut.Background}"
                        CornerRadius="{DynamicResource Theme.Results.Shortcut.CornerRadius}"
                        Padding="5,2"
                        Margin="0,-2,0,0"
                        VerticalAlignment="Center"
                        IsVisible="{Binding Language, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding Language}"
                               Classes="dict-pill"
                               Foreground="{DynamicResource Theme.Results.Category.Color}"
                               FontSize="{DynamicResource Theme.Results.Category.Size}"/>
                </Border>
            </StackPanel>

            <!-- Definitions -->
            <ItemsControl ItemsSource="{Binding Definitions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:DictionaryDefinitionEntry">
                        <StackPanel Orientation="Vertical" Spacing="1" Margin="0,0,0,5">

                            <!-- PartOfSpeech pill + definition text -->
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Grid.Column="0"
                                        Background="{DynamicResource Theme.Results.Shortcut.Background}"
                                        CornerRadius="{DynamicResource Theme.Results.Shortcut.CornerRadius}"
                                        Padding="5,2"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding PartOfSpeech}"
                                               Classes="dict-pill"
                                               Foreground="{DynamicResource Theme.Results.Category.Color}"
                                               FontSize="{DynamicResource Theme.Results.Category.Size}"/>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Definition}"
                                           Foreground="{DynamicResource Theme.Results.Subtitle.Color}"
                                           FontSize="{DynamicResource Theme.Results.Subtitle.Size}"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                            </Grid>

                            <!-- Example (optional, same color as definition) -->
                            <StackPanel IsVisible="{Binding Example, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Orientation="Vertical" Spacing="1">
                                <TextBlock Foreground="{DynamicResource Theme.Results.Subtitle.Color}"
                                           FontSize="{DynamicResource Theme.Results.Subtitle.Size}"
                                           FontStyle="Italic">
                                    <Run Text="&#x201C;"/><Run Text="{Binding Example}"/><Run Text="&#x201D;"/>
                                </TextBlock>
                                <TextBlock IsVisible="{Binding ExampleTranslation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{DynamicResource Theme.Results.Subtitle.Color}"
                                           FontSize="{DynamicResource Theme.Results.Subtitle.Size}"
                                           FontStyle="Italic">
                                    <Run Text="&#x201C;"/><Run Text="{Binding ExampleTranslation}"/><Run Text="&#x201D;"/>
                                </TextBlock>
                            </StackPanel>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>

        <!-- Right: category label / score (debug) -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    Margin="12,2,0,0"
                    Spacing="8">
            <TextBlock x:CompileBindings="False"
                       Text="Definition"
                       Foreground="{DynamicResource Theme.Results.Category.Color}"
                       FontSize="{DynamicResource Theme.Results.Category.Size}"
                       IsVisible="{Binding !DataContext.IsAltPressed, ElementName=RootWindow}"/>
            <TextBlock x:CompileBindings="False"
                       Text="{Binding Score, StringFormat={}{0:F2}}"
                       Foreground="{DynamicResource Theme.Results.Category.Color}"
                       FontSize="{DynamicResource Theme.Results.Category.Size}"
                       IsVisible="{Binding DataContext.IsAltPressed, ElementName=RootWindow}"/>
        </StackPanel>

    </Grid>
</UserControl>
