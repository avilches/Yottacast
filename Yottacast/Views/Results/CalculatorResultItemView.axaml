<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Yottacast.Core.ViewModels;assembly=Yottacast.Core"
             x:Class="Yottacast.Views.Results.CalculatorResultItemView"
             x:DataType="viewModels:CalculatorResultItemViewModel">
    <Grid ColumnDefinitions="*,Auto,*" MinHeight="68" VerticalAlignment="Center" Margin="0,8">

        <!-- Left: formatted expression (what user typed) -->
        <Border Grid.Column="0" Classes="calc-cell" CornerRadius="6" Padding="6,4"
                HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <TextBlock Text="{Binding Subtitle}"
                       Foreground="{DynamicResource Theme.ItemTitle}"
                       FontSize="{DynamicResource Theme.FontSizeCalcValue}"
                       FontWeight="Medium"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <!-- Separator -->
        <TextBlock Grid.Column="1" Text="="
                   Foreground="{DynamicResource Theme.ItemTitle}"
                   VerticalAlignment="Center"
                   Margin="8,0"/>

        <!-- Right: result -->
        <Border Grid.Column="2" Classes="calc-cell" CornerRadius="6" Padding="6,4"
                HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}"
                       Foreground="{DynamicResource Theme.ItemTitle}"
                       FontSize="{DynamicResource Theme.FontSizeCalcValue}"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

    </Grid>
</UserControl>
