<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Yottacast.Core.ViewModels;assembly=Yottacast.Core"
             x:Class="Yottacast.Views.Results.DateSearchResultView"
             x:DataType="viewModels:DateSearchResultViewModel">
    <Grid ColumnDefinitions="*" RowDefinitions="*,Auto" MinHeight="68"
          TextElement.FontFamily="{DynamicResource Theme.Calc.FontFamily}">

        <!-- Row 0: cells row — fills full width uniformly -->
        <ItemsControl Grid.Row="0"
                      ItemsSource="{Binding CellItems}"
                      VerticalAlignment="Center"
                      Margin="0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModels:DateCellItem">
                    <Border CornerRadius="{DynamicResource Theme.Calc.Cell.CornerRadius}"
                                Padding="6,4"
                                HorizontalAlignment="Stretch"
                                Classes.conv-cell-selected="{Binding IsSelected}">
                            <TextBlock Text="{Binding Value}"
                                       Foreground="{DynamicResource Theme.Calc.Result.Color}"
                                       FontSize="{DynamicResource Theme.Calc.Result.Size}"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Row 1: subtitle for the selected cell — always in layout to avoid shifting cells -->
        <TextBlock Grid.Row="1"
                   Text="{Binding SelectedCellSubtitle}"
                   Foreground="{DynamicResource Theme.Calc.Subtitle.Color}"
                   FontSize="{DynamicResource Theme.Calc.Subtitle.Size}"
                   Opacity="{DynamicResource Theme.Calc.Subtitle.Opacity}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6"/>

    </Grid>
</UserControl>
