<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yottacast.ViewModels"
        xmlns:svc="using:Yottacast.Services"
        xmlns:sys="using:System"
        x:Class="Yottacast.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Title="Yottacast Settings"
        Width="700" Height="620"
        SizeToContent="Manual"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.WindowBackground}">

    <!-- Colores inyectados en runtime por AppHandler.ApplySettingsTheme() según el OS.
         Solo se definen aquí los recursos independientes del tema (iconos vectoriales). -->
    <Window.Resources>
        <ResourceDictionary>
            <!-- Iconos vectoriales para la navegación (Bootstrap Icons 16×16, MIT) -->
            <StreamGeometry x:Key="Icon.General">M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872l-.1-.34zM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858z</StreamGeometry>
            <StreamGeometry x:Key="Icon.AppSearch">M2 1a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H2zm5 0a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H7zm-5 5a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H2zm5 0a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H7z</StreamGeometry>
            <StreamGeometry x:Key="Icon.WebSearch">M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm7.5-6.923c-.67.204-1.335.82-1.887 1.855A7.97 7.97 0 0 0 5.145 4H7.5V1.077zM4.09 4a9.267 9.267 0 0 1 .64-1.539 6.7 6.7 0 0 1 .597-.933A7.025 7.025 0 0 0 2.255 4H4.09zm-.582 3.5c.03-.877.138-1.718.312-2.5H1.674a6.958 6.958 0 0 0-.656 2.5h2.49zM4.847 5a12.5 12.5 0 0 0-.338 2.5H7.5V5H4.847zM8.5 5v2.5h2.99a12.495 12.495 0 0 0-.337-2.5H8.5zM4.51 8.5a12.5 12.5 0 0 0 .337 2.5H7.5V8.5H4.51zm3.99 0V11h2.653c.187-.765.306-1.608.338-2.5H8.5zM5.145 12c.138.386.295.744.468 1.068.552 1.035 1.218 1.65 1.887 1.855V12H5.145zm.182 2.472a6.696 6.696 0 0 1-.597-.933A9.268 9.268 0 0 1 4.09 12H2.255a7.024 7.024 0 0 0 3.072 2.472zM3.82 11a13.652 13.652 0 0 1-.312-2.5h-2.49c.062.89.291 1.733.656 2.5H3.82zm6.853 3.472A7.024 7.024 0 0 0 13.745 12H11.91a9.27 9.27 0 0 1-.64 1.539 6.688 6.688 0 0 1-.597.933zM8.5 12v2.923c.67-.204 1.335-.82 1.887-1.855.173-.324.33-.682.468-1.068H8.5zm3.68-1h2.146c.365-.767.594-1.61.656-2.5h-2.49a13.65 13.65 0 0 1-.312 2.5zm2.802-3.5a6.959 6.959 0 0 0-.656-2.5H12.18c.174.782.282 1.623.312 2.5h2.49zM11.27 2.461c.247.464.462.98.64 1.539h1.835a7.024 7.024 0 0 0-3.072-2.472c.218.284.418.598.597.933zM10.855 4a7.966 7.966 0 0 0-.468-1.068C9.835 1.897 9.17 1.282 8.5 1.077V4h2.355z</StreamGeometry>
            <StreamGeometry x:Key="Icon.FileSearch">M9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31L.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3zm-8.322.12C1.72 3.042 1.95 3 2.19 3h5.396l-.707-.707A1 1 0 0 0 6.172 2H2.5a1 1 0 0 0-1 .981l.006.139z</StreamGeometry>
            <StreamGeometry x:Key="Icon.Calculator">M4 2a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H4zm0 1h8a1 1 0 0 1 1 1v2H3V4a1 1 0 0 1 1-1zM3 7h2v2H3V7zm0 3h2v2H3v-2zm3-3h2v2H6V7zm0 3h2v2H6v-2zm3-3h2v5H9V7z</StreamGeometry>
            <StreamGeometry x:Key="Icon.Clipboard">M5 1a1 1 0 0 0-1 1H3a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2h-1a1 1 0 0 0-1-1H5zm0 1h6v1H5V2zM3 4h10v9H3V4zm2 2v1h6V6H5zm0 2v1h6V8H5z</StreamGeometry>
            <StreamGeometry x:Key="Icon.Emoji">M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16zM4.285 9.567a.5.5 0 0 1 .683.183A3.498 3.498 0 0 0 8 11.5a3.498 3.498 0 0 0 3.032-1.75.5.5 0 1 1 .866.5A4.498 4.498 0 0 1 8 12.5a4.498 4.498 0 0 1-3.898-2.25.5.5 0 0 1 .183-.683zM7 6.5C7 7.328 6.552 8 6 8s-1-.672-1-1.5S5.448 5 6 5s1 .672 1 1.5zm4 0c0 .828-.448 1.5-1 1.5s-1-.672-1-1.5S9.448 5 10 5s1 .672 1 1.5z</StreamGeometry>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>

        <!-- Nav button base — template propio para eliminar efectos hover/pressed del FluentTheme -->
        <Style Selector="Button.nav-item">
            <Setter Property="Background"                Value="Transparent"/>
            <Setter Property="BorderThickness"           Value="0"/>
            <Setter Property="HorizontalAlignment"       Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                   Value="12,9"/>
            <Setter Property="CornerRadius"              Value="6"/>
            <Setter Property="Foreground"                Value="{DynamicResource Theme.ItemSubtitle}"/>
            <Setter Property="FontSize"                  Value="{DynamicResource Theme.FontSizeTitle}"/>
            <Setter Property="Focusable"                 Value="False"/>
            <Setter Property="Transitions"               Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="NavContent"
                                      Background="{TemplateBinding Background}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Content="{TemplateBinding Content}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontSize="{TemplateBinding FontSize}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.nav-item:pointerover">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.nav-item.nav-selected">
            <Setter Property="Background" Value="{DynamicResource Theme.ItemSelection}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.ItemSelectionText}"/>
        </Style>

        <!-- Section heading -->
        <Style Selector="TextBlock.section-heading">
            <Setter Property="Foreground"  Value="{DynamicResource Theme.ItemTitle}"/>
            <Setter Property="FontSize"    Value="{DynamicResource Theme.FontSizeNoResults}"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,20"/>
        </Style>

        <!-- Field label -->
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ItemCategory}"/>
            <Setter Property="FontSize"   Value="{DynamicResource Theme.FontSizeSmall}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <!-- ComboBox stretch -->
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding"             Value="10,8"/>
        </Style>

        <!-- Hotkey field -->
        <Style Selector="Border.hotkey-field">
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#868686"/>
            <Setter Property="Background"      Value="{DynamicResource Theme.WindowBackground}"/>
        </Style>
        <Style Selector="Border.hotkey-field.capturing">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#FF3B30"/>
        </Style>


        <!-- Modifier badge inside hotkey field -->
        <Style Selector="Border.modifier-badge">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding"      Value="3,1"/>
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Margin"       Value="0"/>
            <Setter Property="Width"        Value="22"/>
        </Style>
        <Style Selector="Border.modifier-badge TextBlock">
            <Setter Property="FontSize"           Value="13"/>
            <Setter Property="Foreground"         Value="#565656"/>
            <Setter Property="FontWeight"         Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.modifier-badge.active TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Hotkey key text (single TextBlock, style changes with capturing state) -->
        <Style Selector="TextBlock.hotkey-key">
            <Setter Property="Foreground"        Value="{DynamicResource Theme.ItemTitle}"/>
            <Setter Property="FontWeight"         Value="Bold"/>
            <Setter Property="FontSize"           Value="13"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
        </Style>
        <Style Selector="Border.hotkey-field.capturing TextBlock.hotkey-key">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ItemSubtitle}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <!-- Remove button -->
        <Style Selector="Button.remove-btn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="4,2"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Foreground"      Value="{DynamicResource Theme.ItemSubtitle}"/>
        </Style>
        <Style Selector="Button.remove-btn:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ItemTitle}"/>
        </Style>

        <!-- Add button -->
        <Style Selector="Button.add-btn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Theme.Divider}"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Foreground"      Value="{DynamicResource Theme.ItemSubtitle}"/>
            <Setter Property="Margin"          Value="0,10,0,0"/>
        </Style>
        <Style Selector="Button.add-btn:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ItemTitle}"/>
        </Style>

        <!-- Folder missing indicator -->
        <Style Selector="TextBlock.folder-missing">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- Description text -->
        <Style Selector="TextBlock.description">
            <Setter Property="Foreground"   Value="{DynamicResource Theme.ItemSubtitle}"/>
            <Setter Property="FontSize"     Value="{DynamicResource Theme.FontSizeTitle}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,0,0,20"/>
        </Style>

        <!-- Engine table: column header -->
        <Style Selector="TextBlock.table-col-header">
            <Setter Property="Foreground"  Value="{DynamicResource Theme.ItemCategory}"/>
            <Setter Property="FontSize"    Value="{DynamicResource Theme.FontSizeSmall}"/>
            <Setter Property="Margin"      Value="0,0,0,4"/>
        </Style>

        <!-- Engine alias TextBlock (display state) -->
        <Style Selector="TextBlock.engine-alias-label">
            <Setter Property="Foreground"        Value="{DynamicResource Theme.ItemTitle}"/>
            <Setter Property="FontSize"          Value="{DynamicResource Theme.FontSizeTitle}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding"           Value="4,2"/>
            <Setter Property="Cursor"            Value="Arrow"/>
        </Style>

        <!-- Engine alias TextBox (edit state — visible only while editing) -->
        <Style Selector="TextBox.engine-alias-edit">
            <Setter Property="Background"      Value="{DynamicResource Theme.WindowBackground}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Theme.ItemSelection}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="4,2"/>
            <Setter Property="CornerRadius"    Value="3"/>
            <Setter Property="FontSize"        Value="{DynamicResource Theme.FontSizeTitle}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Theme.ItemTitle}"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource Theme.SearchCaret}"/>
        </Style>

        <!-- Engine custom URL TextBox -->
        <Style Selector="TextBox.engine-url">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="BorderBrush"   Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"       Value="4,2"/>
            <Setter Property="CornerRadius"  Value="3"/>
            <Setter Property="FontSize"      Value="10"/>
            <Setter Property="Foreground"    Value="{DynamicResource Theme.ItemSubtitle}"/>
            <Setter Property="CaretBrush"    Value="{DynamicResource Theme.SearchCaret}"/>
        </Style>
        <Style Selector="TextBox.engine-url:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Divider}"/>
        </Style>
        <Style Selector="TextBox.engine-url:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.ItemSelection}"/>
            <Setter Property="Background"  Value="{DynamicResource Theme.WindowBackground}"/>
            <Setter Property="Foreground"  Value="{DynamicResource Theme.ItemTitle}"/>
        </Style>

        <!-- Mode toggle button -->
        <Style Selector="Button.mode-toggle">
            <Setter Property="Background"      Value="{DynamicResource Theme.ItemIconBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="6,3"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="{DynamicResource Theme.FontSizeSmall}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Theme.ItemSubtitle}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MinWidth"        Value="52"/>
        </Style>
        <Style Selector="Button.mode-toggle /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Theme.ItemIconBackground}"/>
        </Style>
        <Style Selector="Button.mode-toggle:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Theme.ItemTitle}"/>
        </Style>
        <Style Selector="Button.mode-toggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Theme.ItemHover}"/>
        </Style>

    </Window.Styles>

    <Grid ColumnDefinitions="180,1,*">

        <!-- ── Sidebar ─────────────────────────────────────────────────────── -->
        <Border Grid.Column="0" Background="{DynamicResource Theme.ItemIconBackground}">
            <StackPanel Spacing="2" Margin="10,16">

                <TextBlock Text="Preferences"
                           Foreground="{DynamicResource Theme.ItemTitle}"
                           FontSize="{DynamicResource Theme.FontSizeSmall}"
                           FontWeight="SemiBold"
                           Margin="12,0,0,16"/>

                <Button Classes="nav-item"
                        Classes.nav-selected="{Binding IsGeneralSelected}"
                        Command="{Binding SelectGeneralCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource Icon.General}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="General" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Classes="nav-item"
                        Classes.nav-selected="{Binding IsAppSearchSelected}"
                        Command="{Binding SelectAppSearchCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource Icon.AppSearch}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="App Search" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Classes="nav-item"
                        Classes.nav-selected="{Binding IsWebSearchSelected}"
                        Command="{Binding SelectWebSearchCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource Icon.WebSearch}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Web Search" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Classes="nav-item"
                        Classes.nav-selected="{Binding IsFileSearchSelected}"
                        Command="{Binding SelectFileSearchCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource Icon.FileSearch}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="File Search" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Classes="nav-item"
                        Classes.nav-selected="{Binding IsCalculatorSelected}"
                        Command="{Binding SelectCalculatorCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource Icon.Calculator}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Calculator" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Classes="nav-item"
                        Classes.nav-selected="{Binding IsClipboardSelected}"
                        Command="{Binding SelectClipboardCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource Icon.Clipboard}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Clipboard" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Classes="nav-item"
                        Classes.nav-selected="{Binding IsEmojiSelected}"
                        Command="{Binding SelectEmojiCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource Icon.Emoji}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Emoji" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>

        <!-- ── Vertical divider ────────────────────────────────────────────── -->
        <Rectangle Grid.Column="1" Fill="{DynamicResource Theme.Divider}"/>

        <!-- ── Content panels ──────────────────────────────────────────────── -->
        <ScrollViewer Grid.Column="2">
            <Panel Margin="28,24">

                <!-- General -->
                <StackPanel Spacing="20" IsVisible="{Binding IsGeneralSelected}">
                    <TextBlock Classes="section-heading" Text="General"/>

                    <!-- Theme -->
                    <StackPanel Spacing="0">
                        <TextBlock Classes="label" Text="Theme"/>
                        <ComboBox ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="svc:ThemeOption">
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Global Hotkey -->
                    <StackPanel Spacing="0">
                        <TextBlock Classes="label" Text="Global Hotkey"/>
                        <Border Classes="hotkey-field"
                                Classes.capturing="{Binding IsCapturingHotkey}"
                                PointerPressed="OnHotkeyAreaPointerPressed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">

                                <!-- Modifier badges -->
                                <Border Classes="modifier-badge" Classes.active="{Binding BadgeCtrlActive}">
                                    <TextBlock Text="{Binding CtrlSymbol}"/>
                                </Border>
                                <Border Classes="modifier-badge" Classes.active="{Binding BadgeAltActive}">
                                    <TextBlock Text="{Binding AltSymbol}"/>
                                </Border>
                                <Border Classes="modifier-badge" Classes.active="{Binding BadgeShiftActive}">
                                    <TextBlock Text="{Binding ShiftSymbol}"/>
                                </Border>
                                <Border Classes="modifier-badge" Classes.active="{Binding BadgeMetaActive}">
                                    <TextBlock Text="{Binding MetaSymbol}"/>
                                </Border>

                                <!-- Key text (style changes via Border.capturing descendant selector) -->
                                <TextBlock Classes="hotkey-key"
                                           Text="{Binding HotkeyKeyText}"/>

                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Terminal -->
                    <StackPanel Spacing="0">
                        <TextBlock Classes="label" Text="Default Terminal"/>
                        <ComboBox ItemsSource="{Binding Terminals}"
                                  SelectedItem="{Binding SelectedTerminal}"
                                  PlaceholderText="No terminals found"/>
                    </StackPanel>

                    <!-- Sticky window -->
                    <StackPanel Spacing="4">
                        <CheckBox Content="Sticky window"
                                  IsChecked="{Binding StickyWindow}"/>
                        <TextBlock Classes="description"
                                   Text="When enabled, the window stays visible when it loses focus."/>
                    </StackPanel>
                </StackPanel>

                <!-- App Search -->
                <StackPanel Spacing="16" IsVisible="{Binding IsAppSearchSelected}">
                    <TextBlock Classes="section-heading" Text="App Search"/>

                    <CheckBox Content="Enable app search"
                              IsChecked="{Binding EnableAppSearch}"/>

                    <StackPanel Spacing="12" IsVisible="{Binding EnableAppSearch}">
                        <TextBlock Classes="description"
                                   Text="Directories where Yottacast looks for applications."/>

                        <ItemsControl ItemsSource="{Binding AppDirectories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="sys:String">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding}"
                                                   Foreground="{DynamicResource Theme.ItemTitle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Classes="remove-btn"
                                                Content="✕"
                                                Tag="{Binding}"
                                                Click="OnRemoveAppDirectoryClicked"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Classes="add-btn"
                                    Content="+ Add Directory"
                                    Click="OnAddAppDirectoryClicked"/>
                            <Button Classes="add-btn"
                                    Content="Add common folders"
                                    IsVisible="{Binding HasMissingCommonAppDirectories}"
                                    Click="OnAddCommonAppDirectoriesClicked"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Web Search -->
                <StackPanel Spacing="16" IsVisible="{Binding IsWebSearchSelected}">
                    <TextBlock Classes="section-heading" Text="Web Search"/>

                    <StackPanel Spacing="0">
                        <TextBlock Classes="label" Text="Default Browser"/>
                        <ComboBox ItemsSource="{Binding Browsers}"
                                  SelectedItem="{Binding SelectedBrowser}"
                                  PlaceholderText="No browsers found"/>
                    </StackPanel>

                    <!-- Engine table -->
                    <StackPanel Spacing="0">
                        <TextBlock Classes="label" Text="Search Engines"/>

                        <!-- Header row -->
                        <Grid ColumnDefinitions="108,58,64,*,42" Margin="2,0,0,0">
                            <TextBlock Grid.Column="0" Classes="table-col-header" Text="Engine"/>
                            <TextBlock Grid.Column="1" Classes="table-col-header" Text="Prefix"/>
                            <TextBlock Grid.Column="2" Classes="table-col-header" Text="Mode" Margin="4,0,0,0"/>
                            <TextBlock Grid.Column="3" Classes="table-col-header" Text="Custom URL" Margin="8,0,0,0"/>
                            <TextBlock Grid.Column="4" Classes="table-col-header" Text="On"
                                       HorizontalAlignment="Center"/>
                        </Grid>

                        <Rectangle Height="1" Fill="{DynamicResource Theme.Divider}" Margin="0,0,0,2"/>

                        <!-- Engine rows -->
                        <ItemsControl ItemsSource="{Binding WebSearchEngines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WebSearchEngineRowViewModel">
                                    <Grid ColumnDefinitions="108,58,64,*,42" MinHeight="30">

                                        <!-- Engine name -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   Foreground="{DynamicResource Theme.ItemTitle}"
                                                   FontSize="{DynamicResource Theme.FontSizeTitle}"
                                                   VerticalAlignment="Center"
                                                   Padding="2,0,4,0"/>

                                        <!-- Prefix alias — label until double-click -->
                                        <Panel Grid.Column="1" Opacity="{Binding PrefixOpacity}">
                                            <TextBlock Text="{Binding Prefix}"
                                                       Classes="engine-alias-label"
                                                       IsVisible="{Binding IsPrefixNotEditing}"
                                                       DoubleTapped="OnPrefixDoubleTapped"/>
                                            <TextBox Text="{Binding Prefix}"
                                                     Classes="engine-alias-edit"
                                                     IsVisible="{Binding IsPrefixEditing}"
                                                     LostFocus="OnPrefixLostFocus"
                                                     KeyDown="OnPrefixKeyDown"/>
                                        </Panel>

                                        <!-- Mode toggle -->
                                        <Button Grid.Column="2"
                                                Content="{Binding ModeLabel}"
                                                Command="{Binding ToggleModeCommand}"
                                                Classes="mode-toggle"
                                                VerticalAlignment="Center"
                                                Margin="4,0"/>

                                        <!-- Custom query URL -->
                                        <TextBox Grid.Column="3"
                                                 Text="{Binding QueryUrl}"
                                                 Watermark="{Binding QueryUrlWatermark}"
                                                 Classes="engine-url"
                                                 VerticalAlignment="Center"
                                                 Margin="4,0"/>

                                        <!-- Enabled -->
                                        <CheckBox Grid.Column="4"
                                                  IsChecked="{Binding Enabled}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- File Search -->
                <StackPanel Spacing="16" IsVisible="{Binding IsFileSearchSelected}">
                    <TextBlock Classes="section-heading" Text="File Search"/>

                    <CheckBox Content="Enable file search"
                              IsChecked="{Binding EnableFileSearch}"/>

                    <StackPanel Spacing="12" IsVisible="{Binding EnableFileSearch}">
                        <TextBlock Classes="description"
                                   Text="Yottacast can search documents and files on your system."/>

                        <CheckBox Content="Only in specific folders"
                                  IsChecked="{Binding FileSearchOnlySpecificFolders}"/>

                        <StackPanel Spacing="8" IsVisible="{Binding FileSearchOnlySpecificFolders}">
                            <TextBlock Classes="description"
                                       Text="Folders where Yottacast searches for documents and files."/>

                            <ItemsControl ItemsSource="{Binding SearchFolders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SearchFolderItem">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding DisplayPath}"
                                                       Classes.folder-missing="{Binding DoesNotExist}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <Button Grid.Column="1"
                                                    Classes="remove-btn"
                                                    Content="✕"
                                                    Tag="{Binding}"
                                                    Click="OnRemoveSearchFolderClicked"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="add-btn"
                                        Content="+ Add Folder"
                                        Click="OnAddSearchFolderClicked"/>
                                <Button Classes="add-btn"
                                        Content="Add common folders"
                                        Click="OnAddCommonFoldersClicked"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Calculator -->
                <StackPanel Spacing="16" IsVisible="{Binding IsCalculatorSelected}">
                    <TextBlock Classes="section-heading" Text="Calculator"/>
                    <TextBlock Classes="description"
                               Text="Evaluate math expressions and unit conversions directly in the search bar."/>
                    <ToggleSwitch IsChecked="{Binding EnableCalculator}"
                                  OnContent="Enabled"
                                  OffContent="Disabled"/>
                </StackPanel>

                <!-- Clipboard -->
                <StackPanel Spacing="16" IsVisible="{Binding IsClipboardSelected}">
                    <TextBlock Classes="section-heading" Text="Clipboard"/>
                    <TextBlock Classes="description"
                               Text="Access your clipboard history from the search bar."/>
                    <ToggleSwitch IsChecked="{Binding EnableClipboard}"
                                  OnContent="Enabled"
                                  OffContent="Disabled"/>
                </StackPanel>

                <!-- Emoji -->
                <StackPanel Spacing="16" IsVisible="{Binding IsEmojiSelected}">
                    <TextBlock Classes="section-heading" Text="Emoji"/>
                    <TextBlock Classes="description"
                               Text="Search and copy emoji from the search bar."/>
                    <ToggleSwitch IsChecked="{Binding EnableEmoji}"
                                  OnContent="Enabled"
                                  OffContent="Disabled"/>
                </StackPanel>

            </Panel>
        </ScrollViewer>

    </Grid>

</Window>
