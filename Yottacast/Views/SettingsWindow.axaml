<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yottacast.ViewModels"
        xmlns:svc="using:Yottacast.Services"
        xmlns:sys="using:System"
        xmlns:settings="using:Yottacast.Views.Settings"
        x:Class="Yottacast.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Title="Yottacast Settings"
        Width="700" Height="620"
        SizeToContent="Manual"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Window.Background}">

    <!-- Colores inyectados en runtime por AppHandler.ApplySettingsTheme() según el OS.
         Solo se definen aquí los recursos independientes del tema (iconos vectoriales). -->
    <Window.Resources>
        <ResourceDictionary>
            <!-- Iconos vectoriales para la navegación (Bootstrap Icons 16×16, MIT) -->
            <StreamGeometry x:Key="Icon.General">M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872l-.1-.34zM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858z</StreamGeometry>
            <StreamGeometry x:Key="Icon.AppSearch">M2 1a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H2zm5 0a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H7zm-5 5a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H2zm5 0a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H7z</StreamGeometry>
            <StreamGeometry x:Key="Icon.WebSearch">M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm7.5-6.923c-.67.204-1.335.82-1.887 1.855A7.97 7.97 0 0 0 5.145 4H7.5V1.077zM4.09 4a9.267 9.267 0 0 1 .64-1.539 6.7 6.7 0 0 1 .597-.933A7.025 7.025 0 0 0 2.255 4H4.09zm-.582 3.5c.03-.877.138-1.718.312-2.5H1.674a6.958 6.958 0 0 0-.656 2.5h2.49zM4.847 5a12.5 12.5 0 0 0-.338 2.5H7.5V5H4.847zM8.5 5v2.5h2.99a12.495 12.495 0 0 0-.337-2.5H8.5zM4.51 8.5a12.5 12.5 0 0 0 .337 2.5H7.5V8.5H4.51zm3.99 0V11h2.653c.187-.765.306-1.608.338-2.5H8.5zM5.145 12c.138.386.295.744.468 1.068.552 1.035 1.218 1.65 1.887 1.855V12H5.145zm.182 2.472a6.696 6.696 0 0 1-.597-.933A9.268 9.268 0 0 1 4.09 12H2.255a7.024 7.024 0 0 0 3.072 2.472zM3.82 11a13.652 13.652 0 0 1-.312-2.5h-2.49c.062.89.291 1.733.656 2.5H3.82zm6.853 3.472A7.024 7.024 0 0 0 13.745 12H11.91a9.27 9.27 0 0 1-.64 1.539 6.688 6.688 0 0 1-.597.933zM8.5 12v2.923c.67-.204 1.335-.82 1.887-1.855.173-.324.33-.682.468-1.068H8.5zm3.68-1h2.146c.365-.767.594-1.61.656-2.5h-2.49a13.65 13.65 0 0 1-.312 2.5zm2.802-3.5a6.959 6.959 0 0 0-.656-2.5H12.18c.174.782.282 1.623.312 2.5h2.49zM11.27 2.461c.247.464.462.98.64 1.539h1.835a7.024 7.024 0 0 0-3.072-2.472c.218.284.418.598.597.933zM10.855 4a7.966 7.966 0 0 0-.468-1.068C9.835 1.897 9.17 1.282 8.5 1.077V4h2.355z</StreamGeometry>
            <StreamGeometry x:Key="Icon.FileSearch">M9.828 3h3.982a2 2 0 0 1 1.992 2.181l-.637 7A2 2 0 0 1 13.174 14H2.826a2 2 0 0 1-1.991-1.819l-.637-7a1.99 1.99 0 0 1 .342-1.31L.5 3a2 2 0 0 1 2-2h3.672a2 2 0 0 1 1.414.586l.828.828A2 2 0 0 0 9.828 3zm-8.322.12C1.72 3.042 1.95 3 2.19 3h5.396l-.707-.707A1 1 0 0 0 6.172 2H2.5a1 1 0 0 0-1 .981l.006.139z</StreamGeometry>
            <StreamGeometry x:Key="Icon.Calculator">M4 2a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H4zm0 1h8a1 1 0 0 1 1 1v2H3V4a1 1 0 0 1 1-1zM3 7h2v2H3V7zm0 3h2v2H3v-2zm3-3h2v2H6V7zm0 3h2v2H6v-2zm3-3h2v5H9V7z</StreamGeometry>
            <StreamGeometry x:Key="Icon.Clipboard">M5 1a1 1 0 0 0-1 1H3a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2h-1a1 1 0 0 0-1-1H5zm0 1h6v1H5V2zM3 4h10v9H3V4zm2 2v1h6V6H5zm0 2v1h6V8H5z</StreamGeometry>
            <StreamGeometry x:Key="Icon.Emoji">M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16zM4.285 9.567a.5.5 0 0 1 .683.183A3.498 3.498 0 0 0 8 11.5a3.498 3.498 0 0 0 3.032-1.75.5.5 0 1 1 .866.5A4.498 4.498 0 0 1 8 12.5a4.498 4.498 0 0 1-3.898-2.25.5.5 0 0 1 .183-.683zM7 6.5C7 7.328 6.552 8 6 8s-1-.672-1-1.5S5.448 5 6 5s1 .672 1 1.5zm4 0c0 .828-.448 1.5-1 1.5s-1-.672-1-1.5S9.448 5 10 5s1 .672 1 1.5z</StreamGeometry>
            <StreamGeometry x:Key="Icon.Plugin">M6 0a.5.5 0 0 1 .5.5V3h3V.5a.5.5 0 0 1 1 0V3h1a.5.5 0 0 1 .5.5v3A3.5 3.5 0 0 1 8.5 10H8v2.5a.5.5 0 0 1-1 0V10h-.5A3.5 3.5 0 0 1 3 6.5v-3A.5.5 0 0 1 3.5 3h2V.5A.5.5 0 0 1 6 0zM4 4v2.5A2.5 2.5 0 0 0 6.5 9h3A2.5 2.5 0 0 0 12 6.5V4H4z</StreamGeometry>
            <StreamGeometry x:Key="Icon.Folder">M1 3.5A1.5 1.5 0 0 1 2.5 2h2.764c.958 0 1.76.56 2.311 1.184C7.985 3.648 8.48 4 9 4h4.5A1.5 1.5 0 0 1 15 5.5v7a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 1 12.5v-9z</StreamGeometry>
            <StreamGeometry x:Key="Icon.Edit">M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5L13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5z</StreamGeometry>
            <StreamGeometry x:Key="Icon.Dictionary">M1 2.828c.885-.37 2.154-.769 3.388-.893 1.33-.134 2.458.063 3.112.752v9.746c-.935-.53-2.12-.603-3.213-.493-1.18.12-2.37.461-3.287.811V2.828zm7.5-.141c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492V2.687zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783z</StreamGeometry>
            <StreamGeometry x:Key="Icon.History">M8.515 1.019A7 7 0 0 0 8 1V0a8 8 0 0 1 .589.022l-.074.997zm2.004.45a7.003 7.003 0 0 0-.985-.299l.219-.976c.383.086.76.2 1.126.342l-.36.933zm1.37.71a7.01 7.01 0 0 0-.439-.27l.493-.87a8.025 8.025 0 0 1 .979.654l-.615.789a6.996 6.996 0 0 0-.418-.302zm1.834 1.79a6.99 6.99 0 0 0-.653-.796l.724-.69c.27.285.52.59.747.91l-.818.576zm.744 1.352a7.08 7.08 0 0 0-.214-.468l.893-.45a7.976 7.976 0 0 1 .45 1.088l-.95.313a7.023 7.023 0 0 0-.179-.483zm.53 2.507a6.991 6.991 0 0 0-.1-1.025l.985-.17c.067.386.106.778.116 1.17l-1 .025zm-.131 1.538c.033-.17.06-.339.081-.51l.993.123a7.957 7.957 0 0 1-.23 1.155l-.964-.267c.046-.165.086-.332.12-.501zm-.952 2.379c.184-.29.346-.594.486-.908l.914.405c-.16.36-.345.706-.555 1.038l-.845-.535zm-.964 1.205c.122-.122.239-.248.35-.378l.758.653a8.073 8.073 0 0 1-.401.432l-.707-.707z M8 1a7 7 0 1 0 4.95 11.95l.707.707A8.001 8.001 0 1 1 8 0v1z M7.5 3a.5.5 0 0 1 .5.5v5.21l3.248 1.856a.5.5 0 0 1-.496.868l-3.5-2A.5.5 0 0 1 7 9V3.5a.5.5 0 0 1 .5-.5z</StreamGeometry>
            <StreamGeometry x:Key="Icon.SystemSettings">M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872l-.1-.34zM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858z</StreamGeometry>
            <StreamGeometry x:Key="Icon.Permissions">M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z</StreamGeometry>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>

        <!-- Nav button base — template propio para eliminar efectos hover/pressed del FluentTheme -->
        <Style Selector="Button.nav-item">
            <Setter Property="Background"                Value="Transparent"/>
            <Setter Property="BorderThickness"           Value="0"/>
            <Setter Property="HorizontalAlignment"       Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                   Value="12,9"/>
            <Setter Property="CornerRadius"              Value="6"/>
            <Setter Property="Foreground"                Value="{DynamicResource Theme.Results.Subtitle.Color}"/>
            <Setter Property="FontSize"                  Value="{DynamicResource Theme.Results.Title.Size}"/>
            <Setter Property="Focusable"                 Value="False"/>
            <Setter Property="Transitions"               Value="{x:Null}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="NavContent"
                                      Background="{TemplateBinding Background}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Content="{TemplateBinding Content}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontSize="{TemplateBinding FontSize}"/>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.nav-item:pointerover">
            <Setter Property="Opacity" Value="1"/>
        </Style>
        <Style Selector="Button.nav-item.nav-selected">
            <Setter Property="Background" Value="{DynamicResource Theme.Results.Selection.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Theme.Results.Selection.Color}"/>
        </Style>

        <!-- Section heading -->
        <Style Selector="TextBlock.section-heading">
            <Setter Property="Foreground"  Value="{DynamicResource Theme.Results.Title.Color}"/>
            <Setter Property="FontSize"    Value="{DynamicResource Theme.NoResults.Title.Size}"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,20"/>
        </Style>

        <!-- Field label -->
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Results.Category.Color}"/>
            <Setter Property="FontSize"   Value="{DynamicResource Theme.Results.Category.Size}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <!-- ComboBox: stretch + borde coherente con flyout-input -->
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding"             Value="10,8"/>
            <Setter Property="Background"          Value="{DynamicResource Theme.Window.Background}"/>
            <Setter Property="BorderBrush"         Value="#868686"/>
            <Setter Property="BorderThickness"     Value="1"/>
            <Setter Property="CornerRadius"        Value="4"/>
        </Style>
        <Style Selector="ComboBox /template/ Border#Background">
            <Setter Property="Background"      Value="{DynamicResource Theme.Window.Background}"/>
            <Setter Property="BorderBrush"     Value="#868686"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="4"/>
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background"  Value="{DynamicResource Theme.Window.Background}"/>
            <Setter Property="BorderBrush" Value="#868686"/>
        </Style>
        <Style Selector="ComboBox:focus /template/ Border#Background,
                         ComboBox:focus-within /template/ Border#Background">
            <Setter Property="Background"  Value="{DynamicResource Theme.Window.Background}"/>
            <Setter Property="BorderBrush" Value="#868686"/>
        </Style>

        <!-- numeric-field: Border wrapper para NumericUpDown.
             Delegamos el borde al Border exterior para evitar que el ControlTheme
             interno de ButtonSpinner sobreescriba el color en el estado :focus-within. -->
        <Style Selector="Border.numeric-field">
            <Setter Property="BorderBrush"     Value="#868686"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Background"      Value="{DynamicResource Theme.Window.Background}"/>
        </Style>
        <!-- El NumericUpDown interior no tiene borde propio.
             Todos los fondos interiores son Transparent: el Border exterior aporta el color.
             Usar Theme.Window.Background causaría que el fondo interior tape los píxeles
             de las esquinas redondeadas del Border exterior al cambiar de color en focus. -->
        <Style Selector="NumericUpDown">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ Border#PART_BorderElement">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown:focus-within /template/ ButtonSpinner#PART_Spinner /template/ Border#PART_BorderElement">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- TextBox interior: padding y altura iguales a flyout-input, sin borde propio -->
        <Style Selector="NumericUpDown TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight"  Value="0"/>
            <Setter Property="Padding"    Value="8,5,8,5"/>
            <Setter Property="FontSize"   Value="12"/>
        </Style>
        <Style Selector="NumericUpDown TextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="NumericUpDown TextBox:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- Suprimir el mensaje de error de validación con un template vacío -->
        <Style Selector="NumericUpDown /template/ DataValidationErrors">
            <Setter Property="ErrorTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Panel/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hotkey field -->
        <Style Selector="Border.hotkey-field">
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#868686"/>
            <Setter Property="Background"      Value="{DynamicResource Theme.Window.Background}"/>
        </Style>
        <Style Selector="Border.hotkey-field.capturing">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#FF3B30"/>
        </Style>


        <!-- Modifier badge inside hotkey field -->
        <Style Selector="Border.modifier-badge">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding"      Value="3,1"/>
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Margin"       Value="0"/>
            <Setter Property="Width"        Value="22"/>
        </Style>
        <Style Selector="Border.modifier-badge TextBlock">
            <Setter Property="FontFamily"          Value="SF Pro Text, Lucida Grande, Segoe UI, Inter"/>
            <Setter Property="FontSize"           Value="13"/>
            <Setter Property="Foreground"         Value="#565656"/>
            <Setter Property="FontWeight"         Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.modifier-badge.active TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Hotkey key text (single TextBlock, style changes with capturing state) -->
        <Style Selector="TextBlock.hotkey-key">
            <Setter Property="Foreground"        Value="{DynamicResource Theme.Results.Title.Color}"/>
            <Setter Property="FontWeight"         Value="Bold"/>
            <Setter Property="FontSize"           Value="13"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
        </Style>
        <Style Selector="Border.hotkey-field.capturing TextBlock.hotkey-key">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Results.Subtitle.Color}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>
        <!-- Remove button -->
        <Style Selector="Button.remove-btn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="4,2"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Foreground"      Value="{DynamicResource Theme.Results.Subtitle.Color}"/>
        </Style>
        <Style Selector="Button.remove-btn:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Results.Title.Color}"/>
        </Style>

        <!-- Add button -->
        <Style Selector="Button.add-btn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Theme.Divider.Color}"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Foreground"      Value="{DynamicResource Theme.Results.Subtitle.Color}"/>
            <Setter Property="Margin"          Value="0,10,0,0"/>
        </Style>
        <Style Selector="Button.add-btn:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Results.Title.Color}"/>
        </Style>

        <!-- Folder missing indicator -->
        <Style Selector="TextBlock.folder-missing">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="PathIcon.folder-missing">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- Description text -->
        <Style Selector="TextBlock.description">
            <Setter Property="Foreground"   Value="{DynamicResource Theme.Results.Subtitle.Color}"/>
            <Setter Property="FontSize"     Value="{DynamicResource Theme.Results.Title.Size}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,0,0,20"/>
        </Style>

        <!-- Engine table: column header -->
        <Style Selector="TextBlock.table-col-header">
            <Setter Property="Foreground"  Value="{DynamicResource Theme.Results.Category.Color}"/>
            <Setter Property="FontSize"    Value="{DynamicResource Theme.Results.Category.Size}"/>
            <Setter Property="Margin"      Value="0,0,0,4"/>
        </Style>

        <!-- Engine alias TextBlock (display state) -->
        <Style Selector="TextBlock.engine-alias-label">
            <Setter Property="Foreground"        Value="{DynamicResource Theme.Results.Title.Color}"/>
            <Setter Property="FontSize"          Value="{DynamicResource Theme.Results.Title.Size}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding"           Value="4,2"/>
            <Setter Property="Cursor"            Value="Arrow"/>
        </Style>

        <!-- Engine alias TextBox (edit state — visible only while editing) -->
        <Style Selector="TextBox.engine-alias-edit">
            <Setter Property="Background"      Value="{DynamicResource Theme.Window.Background}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Theme.Results.Selection.Background}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="4,2"/>
            <Setter Property="CornerRadius"    Value="3"/>
            <Setter Property="FontSize"        Value="{DynamicResource Theme.Results.Title.Size}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Theme.Results.Title.Color}"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource Theme.Search.Caret}"/>
        </Style>

        <!-- Engine custom URL TextBox -->
        <Style Selector="TextBox.engine-url">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="BorderBrush"   Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"       Value="4,2"/>
            <Setter Property="CornerRadius"  Value="3"/>
            <Setter Property="FontSize"      Value="10"/>
            <Setter Property="Foreground"    Value="{DynamicResource Theme.Results.Subtitle.Color}"/>
            <Setter Property="CaretBrush"    Value="{DynamicResource Theme.Search.Caret}"/>
        </Style>
        <Style Selector="TextBox.engine-url:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Divider.Color}"/>
        </Style>
        <Style Selector="TextBox.engine-url:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Results.Selection.Background}"/>
            <Setter Property="Background"  Value="{DynamicResource Theme.Window.Background}"/>
            <Setter Property="Foreground"  Value="{DynamicResource Theme.Results.Title.Color}"/>
        </Style>

        <!-- Edit URL button (inside engine table) -->
        <Style Selector="Button.url-edit-btn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Theme.Divider.Color}"/>
            <Setter Property="Padding"         Value="5,2"/>
            <Setter Property="CornerRadius"    Value="3"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="Foreground"      Value="{DynamicResource Theme.Results.Subtitle.Color}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.url-edit-btn:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Results.Title.Color}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Results.Category.Color}"/>
        </Style>

        <!-- Icon-only button — sin borde, sin reborde cuadrado de hover -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="6"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Foreground"      Value="{DynamicResource Theme.Results.Subtitle.Color}"/>
        </Style>
        <Style Selector="Button.icon-btn /template/ ContentPresenter">
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="CornerRadius"  Value="4"/>
        </Style>
        <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Theme.Results.Hover.Background}"/>
        </Style>
        <Style Selector="Button.icon-btn:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Results.Title.Color}"/>
        </Style>

        <!-- Mode toggle button -->
        <Style Selector="Button.mode-toggle">
            <Setter Property="Background"      Value="{DynamicResource Theme.Results.Icon.Background}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="6,3"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="{DynamicResource Theme.Results.Category.Size}"/>
            <Setter Property="Foreground"      Value="{DynamicResource Theme.Results.Subtitle.Color}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MinWidth"        Value="52"/>
        </Style>
        <Style Selector="Button.mode-toggle /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Theme.Results.Icon.Background}"/>
        </Style>
        <Style Selector="Button.mode-toggle:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Results.Title.Color}"/>
        </Style>
        <Style Selector="Button.mode-toggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Theme.Results.Hover.Background}"/>
        </Style>

        <!-- Inputs dentro del flyout de edición de URL.
             Usamos /template/ para sobreescribir los estilos internos de FluentTheme
             que aplican background/border propios en hover y focus. -->
        <Style Selector="TextBox.flyout-input">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="4"/>
            <Setter Property="Padding"         Value="8,5,8,5"/>
            <Setter Property="MinHeight"       Value="0"/>
            <Setter Property="FontSize"        Value="12"/>
        </Style>
        <Style Selector="TextBox.flyout-input /template/ Border#PART_BorderElement">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="BorderBrush"  Value="#868686"/>
        </Style>
        <Style Selector="TextBox.flyout-input:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="BorderBrush"  Value="#868686"/>
        </Style>
        <Style Selector="TextBox.flyout-input:focus-within /template/ Border#PART_BorderElement">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderBrush"      Value="#868686"/>
            <Setter Property="BorderThickness"  Value="1"/>
        </Style>

        <!-- Checkboxes más compactos -->
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding"   Value="6,2,0,2"/>
            <Setter Property="FontSize"  Value="13"/>
        </Style>
        <Style Selector="CheckBox /template/ Border#NormalRectangle">
            <Setter Property="Width"        Value="14"/>
            <Setter Property="Height"       Value="14"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <!-- Example row button (try-it examples in Calculator section) -->
        <Style Selector="Button.example-row">
            <Setter Property="Background"             Value="Transparent"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="Padding"               Value="8,5"/>
            <Setter Property="HorizontalAlignment"   Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius"          Value="6"/>
            <Setter Property="Cursor"               Value="Hand"/>
        </Style>
        <Style Selector="Button.example-row:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Theme.Results.Selection.Background}"/>
        </Style>

        <!-- Example row: expression column (monospace) -->
        <Style Selector="TextBlock.expr-mono">
            <Setter Property="FontFamily" Value="Courier New, Cascadia Code, Consolas, monospace"/>
            <Setter Property="Foreground"  Value="{DynamicResource Theme.Results.Title.Color}"/>
            <Setter Property="FontSize"    Value="{DynamicResource Theme.Results.Title.Size}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Example row: description column -->
        <Style Selector="TextBlock.expr-desc">
            <Setter Property="Foreground"    Value="{DynamicResource Theme.Results.Subtitle.Color}"/>
            <Setter Property="FontSize"      Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping"  Value="Wrap"/>
        </Style>
        <!-- Subsection heading within a settings section -->
        <Style Selector="TextBlock.subsection-heading">
            <Setter Property="Foreground"  Value="{DynamicResource Theme.Results.Title.Color}"/>
            <Setter Property="FontSize"    Value="{DynamicResource Theme.Results.Title.Size}"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,8,0,0"/>
        </Style>

    </Window.Styles>

    <Grid ColumnDefinitions="180,1,*">

        <!-- ── Sidebar ─────────────────────────────────────────────────────── -->
        <Border Grid.Column="0" Background="{DynamicResource Theme.Results.Icon.Background}">
            <DockPanel>

                <!-- Version at the bottom -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding AppVersion}"
                           Foreground="{DynamicResource Theme.Results.Subtitle.Color}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,12"/>

                <StackPanel Spacing="2" Margin="10,16">

                    <TextBlock Text="Preferences"
                               Foreground="{DynamicResource Theme.Results.Title.Color}"
                               FontSize="{DynamicResource Theme.Results.Category.Size}"
                               FontWeight="SemiBold"
                               Margin="12,0,0,16"/>

                    <Button Classes="nav-item"
                            Classes.nav-selected="{Binding IsGeneralSelected}"
                            Command="{Binding SelectGeneralCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.General}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="General" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="nav-item"
                            Classes.nav-selected="{Binding IsAppSearchSelected}"
                            Command="{Binding SelectAppSearchCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.AppSearch}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="App Search" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="nav-item"
                            Classes.nav-selected="{Binding IsWebSearchSelected}"
                            Command="{Binding SelectWebSearchCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.WebSearch}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Web Search" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="nav-item"
                            Classes.nav-selected="{Binding IsFileSearchSelected}"
                            Command="{Binding SelectFileSearchCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.FileSearch}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="File Search" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="nav-item"
                            Classes.nav-selected="{Binding IsFileEditorSelected}"
                            Command="{Binding SelectFileEditorCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Edit}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Editor" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="nav-item"
                            Classes.nav-selected="{Binding IsCalculatorSelected}"
                            Command="{Binding SelectCalculatorCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Calculator}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Calculator" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="nav-item"
                            Classes.nav-selected="{Binding IsClipboardSelected}"
                            Command="{Binding SelectClipboardCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Clipboard}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Clipboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="nav-item"
                            Classes.nav-selected="{Binding IsEmojiSelected}"
                            Command="{Binding SelectEmojiCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Emoji}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Emoji" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="nav-item"
                            Classes.nav-selected="{Binding IsDictionarySelected}"
                            Command="{Binding SelectDictionaryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.Dictionary}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Dictionary" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="nav-item"
                            Classes.nav-selected="{Binding IsDateSearchSelected}"
                            Command="{Binding SelectDateSearchCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.General}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Date Search" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="nav-item"
                            Classes.nav-selected="{Binding IsHistorySelected}"
                            Command="{Binding SelectHistoryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="{StaticResource Icon.History}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="History" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Classes="nav-item"
                            Classes.nav-selected="{Binding IsPermissionsSelected}"
                            Command="{Binding SelectPermissionsCommand}"
                            IsVisible="{Binding IsPermissionsSectionVisible}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Grid.Column="0" Data="{StaticResource Icon.Permissions}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Permissions" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Ellipse Grid.Column="2"
                                     Width="8" Height="8"
                                     Fill="#FF3B30"
                                     VerticalAlignment="Center"
                                     Margin="6,0,0,0"
                                     IsVisible="{Binding HasPermissionIssue}"/>
                        </Grid>
                    </Button>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Vertical divider ────────────────────────────────────────────── -->
        <Rectangle Grid.Column="1" Fill="{DynamicResource Theme.Divider.Color}"/>

        <!-- ── Content panels ──────────────────────────────────────────────── -->
        <ScrollViewer Grid.Column="2">
            <Panel Margin="28,24">

                <!-- General -->
                <settings:SettingsGeneralView IsVisible="{Binding IsGeneralSelected}"/>

                <!-- App Search -->
                <settings:SettingsAppSearchView IsVisible="{Binding IsAppSearchSelected}"/>

                <!-- Web Search -->
                <StackPanel Spacing="16" IsVisible="{Binding IsWebSearchSelected}">
                    <TextBlock Classes="section-heading" Text="Web Search"/>

                    <ToggleSwitch IsChecked="{Binding EnableWebSearch}"
                                  OnContent="Enabled"
                                  OffContent="Disabled"/>

                    <TextBlock Classes="description"
                               Text="Open web searches from the launcher using any search engine."/>

                    <StackPanel Spacing="16" IsVisible="{Binding EnableWebSearch}">

                    <StackPanel Spacing="4">
                        <ToggleSwitch IsChecked="{Binding EnableUrlValidation}"
                                      OnContent="Validate URLs"
                                      OffContent="Show without validating"/>
                        <TextBlock Classes="description"
                                   Text="When enabled, Yottacast performs a brief DNS lookup and connection to verify that a URL you type actually exists and to load its icon. Disable this to show URL results instantly without any network check."/>
                    </StackPanel>

                    <StackPanel Spacing="0">
                        <TextBlock Classes="label" Text="Default Browser"/>
                        <ComboBox ItemsSource="{Binding Browsers}"
                                  SelectedItem="{Binding SelectedBrowser}"
                                  PlaceholderText="No browsers found"
                                  DropDownOpened="OnBrowserDropDownOpened"/>
                        <TextBlock Text="Searching in application folders…"
                                   FontSize="11" Opacity="0.5" Margin="2,4,0,0"
                                   IsVisible="{Binding IsBrowsersLoading}"/>
                    </StackPanel>

                    <!-- Show disabled toggle: texto + checkbox alineados a la derecha -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                        <TextBlock Text="Show disabled engines"
                                   FontSize="13"
                                   Foreground="{DynamicResource Theme.Results.Title.Color}"
                                   VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding ShowDisabledWebSearchEngines}"
                                  Padding="0"/>
                    </StackPanel>

                    <!-- Engine groups -->
                    <ItemsControl ItemsSource="{Binding WebSearchGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WebSearchGroupViewModel">
                                <StackPanel Spacing="0" Margin="0,0,0,12"
                                            IsVisible="{Binding IsVisible}">
                                    <TextBlock Classes="label" Text="{Binding Title}"/>

                                    <Border BorderThickness="1"
                                            BorderBrush="{DynamicResource Theme.Divider.Color}"
                                            CornerRadius="4"
                                            Padding="0">
                                        <ItemsControl ItemsSource="{Binding Engines}">
                                            <ItemsControl.Styles>
                                                <Style Selector="ContentPresenter:last-child Border">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </Style>
                                            </ItemsControl.Styles>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:WebSearchEngineRowViewModel">
                                                    <Border BorderThickness="0,0,0,1"
                                                            BorderBrush="{DynamicResource Theme.Divider.Color}"
                                                            Padding="6,4"
                                                            IsVisible="{Binding IsVisible}">
                                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">

                                                            <!-- Enabled checkbox -->
                                                            <CheckBox Grid.Column="0"
                                                                      IsChecked="{Binding Enabled}"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,6,0"/>

                                                            <!-- Icon -->
                                                            <Image Grid.Column="1"
                                                                   Source="{Binding Icon}"
                                                                   Width="20" Height="20"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,8,0"
                                                                   IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                                                            <!-- Engine name + Plugin badge + Prefix -->
                                                            <StackPanel Grid.Column="2"
                                                                        Orientation="Horizontal"
                                                                        Spacing="8"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}"
                                                                           Foreground="{DynamicResource Theme.Results.Title.Color}"
                                                                           FontSize="{DynamicResource Theme.Results.Title.Size}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center"/>
                                                                <PathIcon Data="{StaticResource Icon.Plugin}"
                                                                          Width="15" Height="15"
                                                                          MinWidth="15" MinHeight="15"
                                                                          Foreground="{DynamicResource Theme.Results.Subtitle.Color}"
                                                                          VerticalAlignment="Center"
                                                                          IsVisible="{Binding IsPlugin}"
                                                                          ToolTip.Tip="Plugin"/>
                                                                <TextBlock Text="{Binding Prefix}"
                                                                           Foreground="{DynamicResource Theme.Results.Subtitle.Color}"
                                                                           FontSize="{DynamicResource Theme.Results.Title.Size}"
                                                                           VerticalAlignment="Center"
                                                                           IsVisible="{Binding IsPrefixEnabled}"/>
                                                            </StackPanel>

                                                            <!-- Mode toggle button -->
                                                            <Button Grid.Column="3"
                                                                    Content="{Binding ModeLabel}"
                                                                    Command="{Binding ToggleModeCommand}"
                                                                    Classes="mode-toggle"
                                                                    VerticalAlignment="Center"
                                                                    Margin="4,0"/>

                                                            <!-- Settings flyout button (icono, sin borde) -->
                                                            <Button Grid.Column="4"
                                                                    Classes="icon-btn"
                                                                    VerticalAlignment="Center">
                                                                <PathIcon Data="{StaticResource Icon.General}"
                                                                          Width="14" Height="14"/>
                                                                <Button.Flyout>
                                                                    <Flyout Placement="Left"
                                                                           Opened="OnEngineFlyoutOpened">
                                                                        <Flyout.FlyoutPresenterTheme>
                                                                            <ControlTheme TargetType="FlyoutPresenter"
                                                                                          BasedOn="{StaticResource {x:Type FlyoutPresenter}}">
                                                                                <Setter Property="BorderBrush"     Value="#707070"/>
                                                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                                            </ControlTheme>
                                                                        </Flyout.FlyoutPresenterTheme>
                                                                        <StackPanel x:DataType="vm:WebSearchEngineRowViewModel"
                                                                                    Width="380" Spacing="8" Margin="4">

                                                                            <!-- Cabecera: icono + nombre -->
                                                                            <StackPanel Orientation="Horizontal" Spacing="8"
                                                                                        Margin="0,0,0,4">
                                                                                <Image Source="{Binding Icon}"
                                                                                       Width="32" Height="32"
                                                                                       VerticalAlignment="Center"
                                                                                       IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                                                <TextBlock Text="{Binding Name}"
                                                                                           FontSize="13"
                                                                                           FontWeight="SemiBold"
                                                                                           VerticalAlignment="Center"/>
                                                                            </StackPanel>

                                                                            <!-- Mode toggle -->
                                                                            <StackPanel Spacing="4">
                                                                                <TextBlock Text="Mode"
                                                                                           FontSize="11"
                                                                                           Foreground="{DynamicResource Theme.Results.Subtitle.Color}"/>
                                                                                <Button Content="{Binding ModeLabel}"
                                                                                        Command="{Binding ToggleModeCommand}"
                                                                                        Classes="mode-toggle"/>
                                                                            </StackPanel>

                                                                            <TextBlock Text="Prefix"
                                                                                       FontSize="11"
                                                                                       Foreground="{DynamicResource Theme.Results.Subtitle.Color}"/>
                                                                            <TextBox Text="{Binding Prefix}"
                                                                                     Classes="flyout-input"
                                                                                     KeyDown="OnFlyoutInputKeyDown"/>

                                                                            <TextBlock Text="Custom URL  ({0} = query)"
                                                                                       FontSize="11"
                                                                                       Foreground="{DynamicResource Theme.Results.Subtitle.Color}"/>
                                                                            <Grid ColumnDefinitions="*,Auto">
                                                                                <TextBox Grid.Column="0"
                                                                                         Text="{Binding QueryUrl}"
                                                                                         Watermark="{Binding QueryUrlWatermark}"
                                                                                         Classes="flyout-input"
                                                                                         KeyDown="OnFlyoutInputKeyDown"
                                                                                         LostFocus="OnFlyoutUrlLostFocus"/>
                                                                                <Button Grid.Column="1"
                                                                                        Content="✕"
                                                                                        Command="{Binding ResetUrlCommand}"
                                                                                        Click="OnResetUrlClicked"
                                                                                        IsVisible="{Binding HasCustomUrl}"
                                                                                        Classes="remove-btn"
                                                                                        VerticalAlignment="Center"
                                                                                        Margin="4,0,0,0"/>
                                                                            </Grid>

                                                                            <!-- Action buttons -->
                                                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                                                                                <Button Grid.Column="0"
                                                                                        Content="Test URL"
                                                                                        Command="{Binding TestUrlCommand}"
                                                                                        Click="OnTestUrlClicked"
                                                                                        Classes="mode-toggle"
                                                                                        FontSize="11"/>
                                                                                <Button Grid.Column="2"
                                                                                        Content="✕  Close"
                                                                                        Click="OnFlyoutCloseClicked"
                                                                                        Classes="mode-toggle"
                                                                                        FontSize="11"/>
                                                                            </Grid>

                                                                            <!-- Plugin-only actions -->
                                                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                                                        Margin="0,6,0,0"
                                                                                        IsVisible="{Binding IsPlugin}">
                                                                                <Button Command="{Binding ShowPluginFolderCommand}"
                                                                                        Click="OnPluginActionClicked"
                                                                                        Classes="mode-toggle" FontSize="11">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                        <PathIcon Data="{StaticResource Icon.Folder}"
                                                                                                  Width="10" Height="10"/>
                                                                                        <TextBlock Text="Show plugin folder"/>
                                                                                    </StackPanel>
                                                                                </Button>
                                                                                <Button Command="{Binding EditPluginSourceCommand}"
                                                                                        Click="OnPluginActionClicked"
                                                                                        Classes="mode-toggle" FontSize="11">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                        <PathIcon Data="{StaticResource Icon.Edit}"
                                                                                                  Width="10" Height="10"/>
                                                                                        <TextBlock Text="Edit plugin source"/>
                                                                                    </StackPanel>
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </Flyout>
                                                                </Button.Flyout>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    </StackPanel> <!-- /EnableWebSearch -->
                </StackPanel>

                <!-- File Search -->
                <settings:SettingsFileSearchView IsVisible="{Binding IsFileSearchSelected}"/>

                <!-- File Editor -->
                <settings:SettingsFileEditorView IsVisible="{Binding IsFileEditorSelected}"/>

                <!-- Calculator -->
                <StackPanel Spacing="16" IsVisible="{Binding IsCalculatorSelected}">
                    <TextBlock Classes="section-heading" Text="Calculator"/>
                    <ToggleSwitch IsChecked="{Binding EnableCalculator}"
                                  OnContent="Enabled"
                                  OffContent="Disabled"/>
                    <TextBlock Classes="description"
                               Text="Evaluate math, convert units and currencies directly in the search bar."/>

                    <StackPanel Spacing="16" IsVisible="{Binding EnableCalculator}">

                    <!-- Decimal places -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="Result Decimal Places"/>
                        <Border Classes="numeric-field" Width="130" HorizontalAlignment="Left" ClipToBounds="True">
                            <NumericUpDown x:Name="DecimalPlacesInput"
                                           Value="{Binding CalculatorDecimalPlaces}"
                                           Minimum="0" Maximum="6" Increment="1" FormatString="0"/>
                        </Border>
                    </StackPanel>

                    <!-- ── Currency Exchange ── -->
                    <TextBlock Classes="subsection-heading" Text="Currency Exchange"/>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="Default Currency Pair"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding AvailableForexCurrencies}"
                                      SelectedItem="{Binding SelectedCurrencyA}"
                                      Width="160"/>
                            <TextBlock Text="/" Foreground="{DynamicResource Theme.Results.Subtitle.Color}"
                                       VerticalAlignment="Center" FontSize="16"/>
                            <ComboBox ItemsSource="{Binding AvailableForexCurrencies}"
                                      SelectedItem="{Binding SelectedCurrencyB}"
                                      Width="160"/>
                        </StackPanel>
                        <TextBlock Classes="description"
                                   Text="When you type an amount in any currency, it converts to the left currency. The left currency converts to the right."/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="Exchange Rates"/>
                        <CheckBox Content="Include metals (gold, silver, platinum, palladium)"
                                  IsChecked="{Binding CalculatorIncludeMetals}"/>
                        <CheckBox Content="Include cryptocurrencies"
                                  IsChecked="{Binding CalculatorIncludeCrypto}"/>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="label" Text="Refresh Interval"/>
                        <Border Classes="numeric-field" Width="130" HorizontalAlignment="Left" ClipToBounds="True">
                            <NumericUpDown x:Name="ExchangeRateRefreshInput"
                                           Value="{Binding ExchangeRateRefreshIntervalHours}"
                                           Minimum="1" Maximum="168" Increment="1" FormatString="0"/>
                        </Border>
                        <TextBlock Classes="description" Text="How often to check for updated exchange rates (hours)."/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="Last Rate Update"/>
                        <TextBlock Classes="description" Text="{Binding ExchangeRatesLastUpdatedText}"/>
                    </StackPanel>

                    <!-- ── Examples ── -->
                    <TextBlock Classes="subsection-heading" Text="Examples — click to try"/>

                    <TextBlock Classes="label" Text="Math &amp; Algebra"/>
                    <StackPanel Spacing="0">
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="2 + 3 * 4">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="2 + 3 * 4"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Operator precedence → 14" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="sqrt(pi)">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="sqrt(pi)"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Square root of π" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="sin(45 deg)">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="sin(45 deg)"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Trigonometry in degrees → 0.71" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="log(1000, 10)">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="log(1000, 10)"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Logarithm base 10 → 3" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="hypot(3, 4)">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="hypot(3, 4)"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Hypotenuse of 3-4-5 triangle → 5" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="factorial(10)">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="factorial(10)"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="10! = 3,628,800" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="gcd(48, 18)">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="gcd(48, 18)"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Greatest common divisor → 6" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="erf(1)">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="erf(1)"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Error function (statistics) → 0.84" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="2x - 5 = 2">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="2x - 5 = 2"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Solve equation for x → 3.5" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="x^2 - 5x + 6">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="x^2 - 5x + 6"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Factor / derive / integrate" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="sin(x)">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="sin(x)"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="d/dx: cos(x), ∫dx: -cos(x)" Margin="8,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <TextBlock Classes="label" Text="Unit Converter"/>
                    <StackPanel Spacing="0">
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="26 c">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="26 c"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Celsius → Fahrenheit (auto)" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="70 F">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="70 F"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Fahrenheit → Celsius → 21.11 °C" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="100 km/h">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="100 km/h"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Speed → mi/h (auto)" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="100 mph to km/h">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="100 mph to km/h"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="US speed to metric → 160.93 km/h" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="5 kg to lbs">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="5 kg to lbs"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Mass conversion → 11.02 lbs" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="6 ft to m">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="6 ft to m"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Height conversion → 1.83 m" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="1 atm to Pa">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="1 atm to Pa"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Pressure → 101325 Pa" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="5 acre to m2">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="5 acre to m2"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Area → 20234 m²" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="38000 s">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="38000 s"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Decomposes into hours, minutes, secs" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="1500 MB">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="1500 MB"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Best-fit unit → 1.5 GB" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="1 AU to km">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="1 AU to km"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Earth-Sun distance → 149 597 871 km" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="300 Mbps">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="300 Mbps"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Data rate → 37.5 MB/s" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="440 Hz">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="440 Hz"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="A4 note frequency → 26 400 rpm" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="100 km/day to ft/year">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="100 km/day to ft/year"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Cross-unit rate conversion" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="100000 mm">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="100000 mm"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Normalization → 100 m" Margin="8,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <TextBlock Classes="label" Text="Currency Exchange"/>
                    <StackPanel Spacing="0">
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}"
                                CommandParameter="{Binding CurrencyAExampleQuery}">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="{Binding CurrencyAExampleQuery}"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="{Binding CurrencyExampleDesc}" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}"
                                CommandParameter="{Binding CurrencyBExampleQuery}">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="{Binding CurrencyBExampleQuery}"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Explicit currency pair" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="1 BTC"
                                IsVisible="{Binding CalculatorIncludeCrypto}">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="1 BTC"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="{Binding CryptoCurrencyExampleDesc}" Margin="8,0"/>
                            </Grid>
                        </Button>
                        <Button Classes="example-row" Command="{Binding TryExampleCommand}" CommandParameter="1 BTC/year to EUR/h"
                                IsVisible="{Binding CalculatorIncludeCrypto}">
                            <Grid ColumnDefinitions="130,*">
                                <TextBlock Grid.Column="0" Classes="expr-mono" Text="1 BTC/year to EUR/h"/>
                                <TextBlock Grid.Column="1" Classes="expr-desc" Text="Cross-currency rate" Margin="8,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    </StackPanel> <!-- /EnableCalculator -->
                </StackPanel>

                <!-- Clipboard -->
                <StackPanel Spacing="16" IsVisible="{Binding IsClipboardSelected}">
                    <TextBlock Classes="section-heading" Text="Clipboard History"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <RadioButton Content="Off"
                                     GroupName="ClipboardSearchVisibility"
                                     IsChecked="{Binding ClipboardSearchDisabled}"/>
                        <RadioButton Content="Always"
                                     GroupName="ClipboardSearchVisibility"
                                     IsChecked="{Binding ClipboardSearchAlways}"/>
                        <RadioButton Content="Exclusive view only (activate with ⌘F)"
                                     GroupName="ClipboardSearchVisibility"
                                     IsChecked="{Binding ClipboardSearchModeOnly}"/>
                    </StackPanel>

                    <TextBlock Classes="description"
                               Text="Capture everything you copy and search it from Clipboard mode."/>

                    <StackPanel Spacing="0" IsVisible="{Binding ClipboardSearchModeOnlySelected}">
                        <TextBlock Classes="label" Text="Clipboard mode hotkey"/>
                        <Border Classes="hotkey-field"
                                Classes.capturing="{Binding IsCapturingClipboardHotkey}"
                                PointerPressed="OnClipboardHotkeyPointerPressed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
                                <Border Classes="modifier-badge" Classes.active="{Binding ClipboardBadgeCtrlActive}">
                                    <TextBlock Text="{Binding CtrlSymbol}"/>
                                </Border>
                                <Border Classes="modifier-badge" Classes.active="{Binding ClipboardBadgeAltActive}">
                                    <TextBlock Text="{Binding AltSymbol}"/>
                                </Border>
                                <Border Classes="modifier-badge" Classes.active="{Binding ClipboardBadgeShiftActive}">
                                    <TextBlock Text="{Binding ShiftSymbol}"/>
                                </Border>
                                <Border Classes="modifier-badge" Classes.active="{Binding ClipboardBadgeMetaActive}">
                                    <TextBlock Text="{Binding MetaSymbol}"/>
                                </Border>
                                <TextBlock Classes="hotkey-key" Text="{Binding ClipboardHotkeyKeyText}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Separator IsVisible="{Binding ClipboardSearchNotDisabled}"/>

                    <StackPanel Spacing="16" IsVisible="{Binding ClipboardSearchNotDisabled}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="label" Text="Max entries"/>
                            <NumericUpDown Value="{Binding ClipboardHistoryMaxEntries}"
                                           Minimum="1" Maximum="1000"
                                           HorizontalAlignment="Left" Width="120"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Classes="label" Text="Keep for (days)"/>
                            <NumericUpDown Value="{Binding ClipboardHistoryMaxDays}"
                                           Minimum="1" Maximum="365"
                                           HorizontalAlignment="Left" Width="120"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Emoji -->
                <StackPanel Spacing="16" IsVisible="{Binding IsEmojiSelected}">
                    <TextBlock Classes="section-heading" Text="Emoji"/>
                    <ToggleSwitch IsChecked="{Binding EnableEmoji}"
                                  OnContent="Enabled"
                                  OffContent="Disabled"/>
                    <TextBlock Classes="description"
                               Text="Search and copy emoji from the search bar. Type `:` to activate."/>
                </StackPanel>

                <!-- Dictionary -->
                <StackPanel Spacing="16" IsVisible="{Binding IsDictionarySelected}">
                    <TextBlock Classes="section-heading" Text="Dictionary"/>
                    <ToggleSwitch IsChecked="{Binding EnableDictionary}"
                                  OnContent="Enabled"
                                  OffContent="Disabled"/>
                    <TextBlock Classes="description"
                               Text="Look up word definitions from an online dictionary. Activate with a prefix or show definitions for every query."/>

                    <StackPanel Spacing="16" IsVisible="{Binding EnableDictionary}">

                        <StackPanel Spacing="4">
                            <CheckBox Content="Show always (no prefix needed)"
                                      IsChecked="{Binding DictionaryShowAlways}"/>
                            <TextBlock Classes="description"
                                       Text="When enabled, definitions appear for any query. When disabled, type the prefix followed by a space and the word."/>
                        </StackPanel>

                        <StackPanel Spacing="0" IsVisible="{Binding !DictionaryShowAlways}">
                            <TextBlock Classes="label" Text="Prefix"/>
                            <TextBox Text="{Binding DictionaryPrefix}"
                                     Classes="flyout-input"
                                     Watermark="define"
                                     MaxWidth="200"
                                     HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="Languages"/>
                            <TextBlock Classes="description"
                                       Text="Select which languages to look up definitions in."/>
                            <ItemsControl ItemsSource="{Binding DictionaryLanguages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DictionaryLanguageItem">
                                        <CheckBox Content="{Binding Name}"
                                                  IsChecked="{Binding IsSelected}"
                                                  Margin="0,2,16,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Date Search -->
                <StackPanel Spacing="16" IsVisible="{Binding IsDateSearchSelected}">
                    <TextBlock Classes="section-heading" Text="Date Search"/>
                    <ToggleSwitch IsChecked="{Binding EnableDateSearch}"
                                  OnContent="Enabled"
                                  OffContent="Disabled"/>
                    <TextBlock Classes="description"
                               Text="Recognize and format dates and times typed in natural language."/>
                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="Examples to try"/>
                        <TextBlock Classes="description" TextWrapping="Wrap"
                                   Text="next monday · tomorrow · yesterday · in 3 days · last friday · next week · this month · christmas · in 2 weeks · mañana · próxima semana · hace 3 días"/>
                    </StackPanel>

                    <StackPanel Spacing="16" IsVisible="{Binding EnableDateSearch}">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="Short date format"/>
                            <TextBlock Classes="description"
                                       Text="Format for ISO date cells (e.g. 2026-05-11)."/>
                            <ComboBox ItemsSource="{x:Static vm:SettingsWindowViewModel.DateIsoFormatOptions}"
                                      SelectedItem="{Binding DateIsoFormat}"
                                      Width="180"
                                      HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="Long date format"/>
                            <TextBlock Classes="description"
                                       Text="Format for the long date cell (e.g. 11 May 2026 (Monday))."/>
                            <ComboBox ItemsSource="{x:Static vm:SettingsWindowViewModel.DateLongFormatOptions}"
                                      SelectedItem="{Binding DateLongFormat}"
                                      Width="260"
                                      HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- History -->
                <StackPanel Spacing="16" IsVisible="{Binding IsHistorySelected}">
                    <TextBlock Classes="section-heading" Text="History"/>
                    <ToggleSwitch IsChecked="{Binding EnableHistory}"
                                  OnContent="Enabled"
                                  OffContent="Disabled"/>
                    <TextBlock Classes="description"
                               Text="Records searches that end in an action or are dismissed with Escape. Navigate past searches with ↑ or Ctrl+↑ in the search bar."/>

                    <StackPanel Spacing="16" IsVisible="{Binding EnableHistory}">

                        <!-- Max items -->
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Max history items"/>
                            <Border Classes="numeric-field"
                                    Width="130"
                                    HorizontalAlignment="Left"
                                    ClipToBounds="True">
                                <NumericUpDown Value="{Binding HistoryMaxItems}"
                                               Minimum="1"
                                               Maximum="100"
                                               Increment="1"
                                               FormatString="0"/>
                            </Border>
                        </StackPanel>

                        <!-- Clear button -->
                        <Button Content="Clear history"
                                Command="{Binding ClearHistoryCommand}"
                                HorizontalAlignment="Left"/>

                        <!-- Live history log -->
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="History log (most recent first)"/>
                            <ScrollViewer MaxHeight="300"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding HistoryDisplayText}"
                                           FontFamily="Menlo, Consolas, monospace"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource Theme.Results.Subtitle.Color}"/>
                            </ScrollViewer>
                        </StackPanel>

                    </StackPanel>
                </StackPanel>

                <!-- Permissions -->
                <StackPanel Spacing="16" IsVisible="{Binding IsPermissionsSelected}">
                    <TextBlock Classes="section-heading" Text="Permissions"/>

                    <TextBlock Classes="description"
                               TextWrapping="Wrap"
                               Text="Yottacast needs these system permissions. If a row is red, click Grant to open the matching System Settings pane."/>

                    <Border BorderThickness="1"
                            BorderBrush="{DynamicResource Theme.Divider.Color}"
                            CornerRadius="4"
                            Padding="10,8">
                        <StackPanel Spacing="3">
                            <TextBlock Text="In System Settings, look for this entry:"
                                       Foreground="{DynamicResource Theme.Results.Subtitle.Color}"
                                       FontSize="12"/>
                            <TextBlock Text="{Binding PermissionsProcessName}"
                                       FontFamily="Menlo, Consolas, monospace"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Theme.Results.Title.Color}"
                                       FontSize="13"/>
                            <TextBlock Text="{Binding PermissionsProcessPath}"
                                       FontFamily="Menlo, Consolas, monospace"
                                       Foreground="{DynamicResource Theme.Results.Subtitle.Color}"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding PermissionRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PermissionRowViewModel">
                                <Border BorderThickness="1"
                                        BorderBrush="{DynamicResource Theme.Divider.Color}"
                                        CornerRadius="6"
                                        Padding="14,12"
                                        Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <Ellipse Grid.Column="0"
                                                 Width="12" Height="12"
                                                 Fill="{Binding StatusBrush}"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource Theme.Results.Title.Color}"
                                                       FontSize="{DynamicResource Theme.Results.Title.Size}"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{DynamicResource Theme.Results.Subtitle.Color}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="Grant"
                                                Command="{Binding RequestCommand}"
                                                IsVisible="{Binding !IsGranted}"
                                                VerticalAlignment="Center"
                                                Margin="12,0,0,0"/>
                                        <Button Grid.Column="2"
                                                Content="Review"
                                                Command="{Binding RequestCommand}"
                                                IsVisible="{Binding IsGranted}"
                                                FontSize="11"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                Margin="12,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </Panel>
        </ScrollViewer>

    </Grid>

</Window>
