<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Yottacast.Core.ViewModels;assembly=Yottacast.Core"
             xmlns:aedit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
             x:Class="Yottacast.Views.EditorPanelView"
             x:DataType="vm:EditorPanelViewModel">

    <UserControl.Styles>
        <Style Selector="Button.menu-option">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="{DynamicResource Theme.Menu.Option.Padding}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Theme.Menu.Option.CornerRadius}"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.menu-option /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.menu-option:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Theme.Menu.OptionSelected.Background}"/>
        </Style>
        <Style Selector="Button.menu-option:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Menu.OptionSelected.Color}"/>
        </Style>
        <Style Selector="Button.menu-option:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Theme.Menu.OptionSelected.Background}"/>
        </Style>
        <Style Selector="Button.menu-option:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Theme.Menu.OptionSelected.Background}"/>
        </Style>
        <Style Selector="Button.menu-option:focus TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Theme.Menu.OptionSelected.Color}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- Separator vertical izquierdo -->
        <Border Grid.RowSpan="4"
                Width="1"
                HorizontalAlignment="Left"
                Background="{DynamicResource Theme.Divider.Color}"/>

        <!-- ── Edit header ── -->
        <Border Grid.Row="0"
                IsVisible="{Binding IsEditMode}"
                Background="{DynamicResource Theme.Editor.Header.Background}"
                Padding="{DynamicResource Theme.Editor.Header.Padding}"
                Margin="{DynamicResource Theme.Editor.Header.Margin}"
                MinHeight="40">
            <TextBlock Text="{Binding TitleText}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Theme.Editor.Header.Color}"
                       FontSize="{DynamicResource Theme.Editor.Header.Size}"
                       FontFamily="{DynamicResource Theme.Editor.Header.FontFamily}"/>
        </Border>

        <!-- ── Editor / Markdown Preview ── -->
        <Panel Grid.Row="1">
            <!-- AvaloniaEdit: ficheros de código/texto y .md en modo Edit -->
            <Border IsVisible="{Binding !IsMarkdownPreview}"
                    Background="{DynamicResource Theme.Editor.Body.Background}"
                    CornerRadius="0">
                <aedit:TextEditor x:Name="Editor"
                                  IsReadOnly="{Binding IsPreviewMode}"
                                  ShowLineNumbers="False"
                                  FontFamily="Cascadia Code, Fira Code, Menlo, Consolas, monospace"
                                  FontSize="13"
                                  WordWrap="{Binding WordWrap}"
                                  Background="Transparent"/>
            </Border>
            <!-- Markdown renderizado: solo para .md en modo Preview -->
            <Border IsVisible="{Binding IsMarkdownPreview}"
                    Background="{DynamicResource Theme.Editor.Body.Background}"
                    Padding="12,8">
                <md:MarkdownScrollViewer Markdown="{Binding Content}"/>
            </Border>
        </Panel>

        <!-- ── Edit footer: fila/col y estadísticas del documento ── -->
        <Border Grid.Row="2"
                IsVisible="{Binding IsEditMode}"
                Background="{DynamicResource Theme.Editor.Footer.Background}"
                BorderBrush="{DynamicResource Theme.Editor.Footer.Border}"
                BorderThickness="0,1,0,0"
                Padding="{DynamicResource Theme.Editor.Footer.Padding}">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="{Binding StatusText}"
                           FontSize="{DynamicResource Theme.Editor.Footer.Size}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Theme.Editor.Footer.Color}"/>
                <TextBlock Text="{Binding CharCountText}"
                           FontSize="{DynamicResource Theme.Editor.Footer.Size}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Theme.Editor.Footer.Color}"/>
            </StackPanel>
        </Border>

        <!-- ── Clipboard preview status bar: words, chars, copied time ── -->
        <Border Grid.Row="3"
                IsVisible="{Binding ClipboardStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="{DynamicResource Theme.Editor.Footer.Background}"
                BorderBrush="{DynamicResource Theme.Editor.Footer.Border}"
                BorderThickness="0,1,0,0"
                Padding="{DynamicResource Theme.Editor.Footer.Padding}">
            <TextBlock Text="{Binding ClipboardStatusText}"
                       FontSize="{DynamicResource Theme.Editor.Footer.Size}"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Theme.Editor.Footer.Color}"/>
        </Border>

        <!-- ── Unsaved changes dialog ── -->
        <Grid Grid.RowSpan="4"
              x:Name="DialogOverlay"
              IsVisible="{Binding ShowUnsavedDialog}"
              Background="#60000000">
            <Border Background="{DynamicResource Theme.Menu.Background}"
                    BorderBrush="{DynamicResource Theme.Menu.Border.Color}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Theme.Menu.Border.Radius}"
                    MinWidth="220"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <!-- Header -->
                    <Border Background="{DynamicResource Theme.Menu.Header.Background}"
                            Padding="{DynamicResource Theme.Menu.Header.Padding}"
                            Margin="{DynamicResource Theme.Menu.Header.Margin}">
                        <TextBlock Text="Unsaved changes"
                                   Foreground="{DynamicResource Theme.Menu.Header.Color}"
                                   FontSize="{DynamicResource Theme.Menu.Header.Size}"/>
                    </Border>
                    <!-- Options -->
                    <Border Padding="4,0,4,4">
                    <StackPanel>
                        <Button x:Name="SaveDialogButton"
                                Classes="menu-option"
                                Command="{Binding SaveAndCloseCommand}"
                                PointerEntered="OnDialogButtonPointerEntered">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Save"
                                           Foreground="{DynamicResource Theme.Menu.Option.Color}"
                                           FontSize="{DynamicResource Theme.Menu.Option.Size}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="⌘E"
                                           Foreground="{DynamicResource Theme.Menu.Header.Color}"
                                           FontSize="{DynamicResource Theme.Menu.Option.Size}"
                                           VerticalAlignment="Center"
                                           Margin="20,0,0,0"/>
                            </Grid>
                        </Button>
                        <Button x:Name="DiscardDialogButton"
                                Classes="menu-option"
                                Command="{Binding DiscardAndCloseCommand}"
                                PointerEntered="OnDialogButtonPointerEntered">
                            <TextBlock Text="Don't save"
                                       Foreground="{DynamicResource Theme.Menu.Option.Color}"
                                       FontSize="{DynamicResource Theme.Menu.Option.Size}"/>
                        </Button>
                        <Button x:Name="CancelDialogButton"
                                Classes="menu-option"
                                Command="{Binding CancelUnsavedDialogCommand}"
                                PointerEntered="OnDialogButtonPointerEntered">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Cancel"
                                           Foreground="{DynamicResource Theme.Menu.Option.Color}"
                                           FontSize="{DynamicResource Theme.Menu.Option.Size}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Esc"
                                           Foreground="{DynamicResource Theme.Menu.Header.Color}"
                                           FontSize="{DynamicResource Theme.Menu.Option.Size}"
                                           VerticalAlignment="Center"
                                           Margin="20,0,0,0"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
