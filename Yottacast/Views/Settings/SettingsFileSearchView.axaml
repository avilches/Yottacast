<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yottacast.ViewModels"
             x:Class="Yottacast.Views.Settings.SettingsFileSearchView"
             x:DataType="vm:SettingsWindowViewModel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Yottacast/Views/Settings/SettingsResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://Yottacast/Views/Settings/SettingsStyles.axaml"/>
    </UserControl.Styles>

    <StackPanel Spacing="16">
        <TextBlock Classes="section-heading" Text="File Search"/>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <RadioButton Content="Off"
                         GroupName="FileSearchVisibility"
                         IsChecked="{Binding FileSearchDisabled}"/>
            <RadioButton Content="Always"
                         GroupName="FileSearchVisibility"
                         IsChecked="{Binding FileSearchAlways}"/>
            <RadioButton Content="Exclusive view only (activate with ⌘F)"
                         GroupName="FileSearchVisibility"
                         IsChecked="{Binding FileSearchModeOnly}"/>
        </StackPanel>

        <TextBlock Classes="description"
                   Text="Search for documents and files on your system."/>

        <StackPanel Spacing="12" IsVisible="{Binding FileSearchNotDisabled}">

            <CheckBox Content="Only in specific folders"
                      IsChecked="{Binding FileSearchOnlySpecificFolders}"/>

            <StackPanel Spacing="8" IsVisible="{Binding FileSearchOnlySpecificFolders}">
                <TextBlock Classes="description"
                           Text="Folders where Yottacast searches for documents and files."/>

                <Border BorderThickness="1"
                        BorderBrush="{DynamicResource Theme.Divider.Color}"
                        CornerRadius="4"
                        Padding="0"
                        IsVisible="{Binding HasSearchFolders}">
                    <ItemsControl ItemsSource="{Binding SearchFolders}">
                        <ItemsControl.Styles>
                            <Style Selector="ContentPresenter:last-child Border">
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SearchFolderItem">
                                <Border BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource Theme.Divider.Color}"
                                        Padding="10,7">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                        <PathIcon Grid.Column="0"
                                                  Data="{StaticResource Icon.FileSearch}"
                                                  Width="13" Height="13"
                                                  Classes.folder-missing="{Binding DoesNotExist}"
                                                  VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding RawPath}"
                                                   Classes.folder-missing="{Binding DoesNotExist}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="2"
                                                Classes="remove-btn"
                                                Content="✕"
                                                Tag="{Binding}"
                                                Click="OnRemoveSearchFolderClicked"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="add-btn"
                            Content="+ Add Folder"
                            Click="OnAddSearchFolderClicked"/>
                    <Button Classes="add-btn"
                            Content="Add common folders"
                            Click="OnAddCommonFoldersClicked"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
