<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yottacast.ViewModels"
             x:Class="Yottacast.Views.Settings.SettingsEmojiView"
             x:DataType="vm:SettingsWindowViewModel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Yottacast/Views/Settings/SettingsResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://Yottacast/Views/Settings/SettingsStyles.axaml"/>
    </UserControl.Styles>

    <StackPanel Spacing="16">
        <TextBlock Classes="section-heading" Text="Emoji"/>
        <ToggleSwitch IsChecked="{Binding EnableEmoji}"
                      OnContent="Enabled"
                      OffContent="Disabled"/>
        <TextBlock Classes="description"
                   Text="Search and copy emoji from the search bar. Type `:` to activate."/>
    </StackPanel>
</UserControl>
