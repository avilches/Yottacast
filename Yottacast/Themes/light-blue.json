{
  "name": "Light Blue",
  "variant": "light",

  "window": {
    "background": "#F5EEF4FF",
    "width": 730,
    "cornerRadius": 14,
    "fontFamily": ""
  },

  "search": {
    "text":        { "color": "#1E293B", "size": 18, "fontFamily": "" },
    "placeholder": { "color": "#94A3B8" },
    "caret":       { "color": "#2563EB" },
    "selection":   { "color": "#BFDBFE" },
    "hint":        { "color": "#D32F2F" }
  },

  "divider": { "color": "#E2E8F0" },
  "spinner": { "color": "#94A3B8" },

  "results": {
    "cornerRadius": 8,
    "title":    { "color": "#1E293B", "size": 14 },
    "subtitle": { "color": "#64748B", "size": 12 },
    "category": { "color": "#94A3B8", "size": 11 },
    "icon":     { "background": "#EFF6FF", "cornerRadius": 8 },
    "shortcut": { "color": "#64748B", "background": "#DBEAFE", "size": 11, "cornerRadius": 5 },
    "selection": {
      "background": "#2563EB",
      "hoverBackground": "#1D4ED8",
      "color": "#FFFFFF",
      "iconBackground": "#40FFFFFF"
    },
    "hover": { "background": "#12000000" }
  },

  "calculator": {
    "fontFamily": "",
    "expression": { "color": "#1E293B", "size": 20 },
    "result":     { "color": "#1E293B", "size": 20 },
    "subtitle":   { "color": "#1E293B", "size": 13, "opacity": 0.55 },
    "separator":  { "color": "#1E293B" },
    "cell":       { "background": "#EFF6FF", "cornerRadius": 6 }
  },

  "converter": {
    "fontFamily": "",
    "value":    { "color": "#1E293B", "size": 20 },
    "subtitle": { "color": "#1E293B", "size": 13, "opacity": 0.55 },
    "arrow":    { "color": "#1E293B" },
    "hint":     { "color": "#64748B", "size": 12 },
    "cell":     { "cornerRadius": 6 }
  },

  "emoji": {
    "columns": 10,
    "viewportRows": 8,
    "cell":     { "size": 48, "cornerRadius": 8 },
    "char":     { "size": 28, "fontFamily": "Apple Color Emoji, Segoe UI Emoji, Noto Color Emoji" },
    "name":     { "color": "#1E293B", "size": 14 },
    "keywords": { "color": "#1E293B", "size": 11, "opacity": 0.55 },
    "sectionHeader": { "color": "#64748B", "size": 11, "opacity": 0.7 },
    "favorite": { "color": "#EAB308", "size": 8, "opacity": 0.8 },
    "usageCount": { "color": "#64748B", "size": 9, "opacity": 0.5 }
  },

  "noResults": {
    "title":    { "color": "#64748B", "size": 16 },
    "subtitle": { "color": "#94A3B8", "size": 14 }
  },

  "footer": {
    "border": "#E2E8F0",
    "text": { "color": "#94A3B8", "size": 11 }
  },

  "escBadge": {
    "background": "#EFF6FF",
    "cornerRadius": 6,
    "text": { "color": "#94A3B8", "size": 11 }
  },

  "updateBanner": {
    "background": "#2563EB",
    "text": { "color": "#FFFFFF", "size": 11 }
  }
}
