{
  "id": "light-blue",
  "name": "Light Blue",
  "variant": "light",

  "window": {
    "background": "#EEF4FF",
    "width": 730,
    "cornerRadius": 14,
    "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter"
  },

  "search": {
    "background": "Transparent",
    "input": {
      "cornerRadius": 0,
      "margin": "0",
      "padding": "18,0",
      "border": { "color": "Transparent", "thickness": "0" }
    },
    "text":        { "color": "#1E293B", "size": 18, "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter" },
    "placeholder": { "color": "#94A3B8" },
    "caret":       { "color": "#2563EB" },
    "selection":   { "color": "#BFDBFE" },
    "hint": {
      "error": {
        "color": "#F35F5F", "size": 11, "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter",
        "padding": "0", "background": "Transparent", "cornerRadius": 0, "textAlignment": "left", "horizontalAlignment": "stretch",
        "margin": "28,0,0,0"
      },
      "info": {
        "color": "#9CA3AF", "size": 11, "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter",
        "padding": "0", "background": "Transparent", "cornerRadius": 0, "textAlignment": "left", "horizontalAlignment": "stretch",
        "margin": "28,0,0,0"
      }
    }
  },

  "divider": { "color": "#E2E8F0" },
  "spinner": { "color": "#94A3B8" },

  "results": {
    "maxHeight": 540,
    "background": "#F5F9FF",
    "padding": 8,
    "cornerRadius": 8,
    "selectionBar": { "color": "#2563EB", "width": 4 },
    "title":    { "color": "#1E293B", "size": 14 },
    "subtitle": { "color": "#64748B", "size": 12 },
    "category": { "color": "#94A3B8", "size": 11 },
    "icon":     { "cornerRadius": 8 },
    "shortcut": { "color": "#64748B", "background": "#DBEAFE", "size": 11, "cornerRadius": 5 },
    "selection": { "background": "#2563EB", "color": "#FFFFFF" },
    "matchHighlight": {
      "style": "foreground",
      "color": "#2563EB",
      "backgroundOpacity": 0.22
    }
  },

  "calculator": {
    "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter",
    "expression": { "color": "#1E293B", "size": 20, "fontWeight": "Medium" },
    "result":     { "color": "#1E293B", "size": 20, "fontWeight": "Medium" },
    "subtitle":   { "color": "#1E293B", "size": 13, "opacity": 0.55 },
    "separator":  { "color": "#1E293B" },
    "cell":       { "cornerRadius": 6 }
  },

  "converter": {
    "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter",
    "value":    { "color": "#1E293B", "size": 20 },
    "subtitle": { "color": "#1E293B", "size": 13, "opacity": 0.55 },
    "arrow":    { "color": "#1E293B" },
    "cell":     { "cornerRadius": 6 }
  },

  "emoji": {
    "columns": 10,
    "cell":     { "size": 48, "cornerRadius": 8 },
    "char":     { "size": 28, "fontFamily": "Apple Color Emoji, Segoe UI Emoji, Noto Color Emoji" },
    "keywords": { "color": "#1E293B", "size": 11, "opacity": 0.55 },
    "sectionHeader": { "color": "#64748B", "size": 11, "opacity": 0.7 },
    "favorite": { "color": "#EAB308", "size": 8, "opacity": 0.8 },
    "usageCount": { "color": "#64748B", "size": 9, "opacity": 0.5 }
  },

  "noResults": {
    "title":    { "color": "#64748B", "size": 16 },
    "subtitle": { "color": "#94A3B8", "size": 14 }
  },

  "footer": {
    "background": "#EEF4FF",
    "border": "#DBEAFE",
    "text": { "color": "#64748B", "size": 12 }
  },


  "optionsMenu": {
    "background": "#EEF4FF",
    "border": { "color": "#BFDBFE", "radius": 8 },
    "header": {
      "color": "#64748B", "size": 11, "background": "#00000000",
      "padding": "12,6,12,4", "margin": "0,0,0,2"
    },
    "option": { "color": "#1E293B", "size": 13, "padding": "12,7", "cornerRadius": 6 },
    "optionSelected": { "background": "#2563EB", "color": "#FFFFFF" }
  },

  "updateBanner": {
    "background": "#2563EB",
    "text": { "color": "#FFFFFF", "size": 11 }
  },

  "preview": {
    "width": 400
  }
}
