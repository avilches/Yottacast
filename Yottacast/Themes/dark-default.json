{
  "id": "dark-default",
  "name": "Dark Default",
  "variant": "dark",

  "window": {
    "background": "#1C1C22",
    "width": 730,
    "cornerRadius": 14,
    "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter"
  },

  "search": {
    "background": "#0D0D12",
    "input": {
      "cornerRadius": 0,
      "margin": "0",
      "padding": "18,12",
      "border": { "color": "#5E8FFF", "thickness": "0,0,0,1" }
    },
    "text":        { "color": "#FFFFFF", "size": 18, "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter" },
    "placeholder": { "color": "#505055" },
    "caret":       { "color": "#5E8FFF" },
    "selection":   { "color": "#3560EE" },
    "hint": {
      "error": {
        "color": "#FF3B30", "size": 12, "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter",
        "padding": "0", "background": "Transparent", "cornerRadius": 0, "textAlignment": "center", "horizontalAlignment": "stretch", "margin": "30,0,20,6"
      },
      "info": {
        "color": "#9A9AA4", "size": 12, "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter",
        "padding": "0", "background": "Transparent", "cornerRadius": 0, "textAlignment": "center", "horizontalAlignment": "stretch", "margin": "30,0,20,6"
      }
    }
  },

  "divider": { "color": "#2A2A30" },
  "spinner": { "color": "#505055" },

  "results": {
    "maxHeight": 540,
    "background": "#1C1C22",
    "padding": 8,
    "cornerRadius": 8,
    "selectionBar": { "color": "#2C5AF0", "width": 4 },
    "title":    { "color": "#EAEAEE", "size": 14 },
    "subtitle": { "color": "#9A9AA4", "size": 12 },
    "category": { "color": "#606068", "size": 12 },
    "icon":     { "cornerRadius": 8 },
    "shortcut": { "color": "#505055", "background": "#252529", "size": 12, "cornerRadius": 5 },
    "selection": { "background": "#2C5AF0", "color": "#FFFFFF" }
  },

  "calculator": {
    "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter",
    "expression": { "color": "#EAEAEE", "size": 20, "fontWeight": "Medium" },
    "result":     { "color": "#EAEAEE", "size": 20, "fontWeight": "Medium" },
    "subtitle":   { "color": "#EAEAEE", "size": 13, "opacity": 0.55 },
    "separator":  { "color": "#EAEAEE" },
    "cell":       { "cornerRadius": 6 }
  },

  "converter": {
    "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter",
    "value":    { "color": "#EAEAEE", "size": 20 },
    "subtitle": { "color": "#EAEAEE", "size": 13, "opacity": 0.55 },
    "arrow":    { "color": "#EAEAEE" },
    "cell":     { "cornerRadius": 6 }
  },

  "emoji": {
    "cell":     { "size": 64,
      "cornerRadius": 8, "margin": 2 },      
    "char":     { "size": 48, "fontFamily": "Apple Color Emoji, Segoe UI Emoji, Noto Color Emoji" },
    "keywords": { "color": "#EAEAEE", "size": 12, "opacity": 0.55 },
    "sectionHeader": { "color": "#EAEAEE", "size": 11, "opacity": 0.5 },
    "favorite": { "color": "#FFD60A", "size": 8, "opacity": 0.7 },
    "usageCount": { "color": "#EAEAEE", "size": 9, "opacity": 0.4 }
  },

  "noResults": {
    "title":    { "color": "#505055", "size": 16 },
    "subtitle": { "color": "#36363C", "size": 14 }
  },

  "footer": {
    "background": "#1C1C22",
    "border": "#2A2A30",
    "text": { "color": "#9A9AA4", "size": 13 }
  },


  "optionsMenu": {
    "background": "#1C1C22",
    "border": { "color": "#3A3A50", "radius": 8 },
    "header": {
      "color": "#606068", "size": 11, "background": "#00000000",
      "padding": "12,6,12,4", "margin": "0,0,0,2"
    },
    "option": { "color": "#EAEAEE", "size": 13, "padding": "12,6", "cornerRadius": 6 },
    "optionSelected": { "background": "#2C5AF0", "color": "#FFFFFF" }
  },

  "updateBanner": {
    "background": "#2C5AF0",
    "text": { "color": "#FFFFFF", "size": 12 }
  }
}
