{
  "id": "dark-macos",
  "name": "Dark macOS",
  "variant": "dark",

  "window": {
    "background": "#1C1C1E",
    "width": 710,
    "cornerRadius": 16,
    "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter"
  },

  "search": {
    "background": "Transparent",
    "input": {
      "cornerRadius": 0,
      "margin": "8,8",
      "padding": "2,-8",
      "border": { "color": "#FF0000", "thickness": "1" }
    },
    "text":        { "color": "#F2F2F7", "size": 17, "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter" },
    "placeholder": { "color": "#636366" },
    "caret":       { "color": "#0A84FF" },
    "selection":   { "color": "#0866CC" },
    "hint": {
      "error": {
        "color": "#DFDFDF", "size": 11, "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter",
        "padding": "6,2,6,3", "background": "#661414", "cornerRadius": 5, "textAlignment": "center", "horizontalAlignment": "center", "margin": "28,0,28,-8"
      },
      "info": {
        "color": "#9A9AA4", "size": 11, "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter",
        "padding": "0", "background": "Transparent", "cornerRadius": 0, "textAlignment": "left", "horizontalAlignment": "stretch",
        "margin": "28,0,0,0"
      }
    }
  },

  "divider": { "color": "#38383A" },
  "spinner": { "color": "#636366" },

  "results": {
    "maxHeight": 540,
    "background": "#111114",
    "padding": 8,
    "cornerRadius": 10,
    "selectionBar": { "color": "#0A84FF", "width": 4 },
    "title":    { "color": "#F2F2F7", "size": 14 },
    "subtitle": { "color": "#8E8E93", "size": 12 },
    "category": { "color": "#70707A", "size": 12 },
    "icon":     { "cornerRadius": 8 },
    "shortcut": { "color": "#8E8E93", "background": "#3A3A3C", "size": 12, "cornerRadius": 6 },
    "selection": { "background": "#0A84FF", "color": "#FFFFFF" },
    "matchHighlight": {
      "style": "foreground",
      "color": "#0A84FF",
      "backgroundOpacity": 0.22
    }
  },

  "calculator": {
    "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter",
    "expression": { "color": "#F2F2F7", "size": 20, "fontWeight": "Medium" },
    "result":     { "color": "#F2F2F7", "size": 20, "fontWeight": "Medium" },
    "subtitle":   { "color": "#F2F2F7", "size": 13, "opacity": 0.55 },
    "separator":  { "color": "#F2F2F7" },
    "cell":       { "cornerRadius": 6 }
  },

  "converter": {
    "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter",
    "value":    { "color": "#F2F2F7", "size": 20 },
    "subtitle": { "color": "#F2F2F7", "size": 13, "opacity": 0.55 },
    "arrow":    { "color": "#F2F2F7" },
    "cell":     { "cornerRadius": 6 }
  },

  "emoji": {
    "columns": 10,
    "cell":     { "size": 48, "cornerRadius": 8 },
    "char":     { "size": 28, "fontFamily": "Apple Color Emoji, Segoe UI Emoji, Noto Color Emoji" },
    "keywords": { "color": "#F2F2F7", "size": 12, "opacity": 0.55 },
    "sectionHeader": { "color": "#F2F2F7", "size": 11, "opacity": 0.5 },
    "favorite": { "color": "#FFD60A", "size": 8, "opacity": 0.7 },
    "usageCount": { "color": "#F2F2F7", "size": 9, "opacity": 0.4 }
  },

  "noResults": {
    "title":    { "color": "#8E8E93", "size": 15 },
    "subtitle": { "color": "#636366", "size": 14 }
  },

  "footer": {
    "background": "#1C1C1E",
    "border": "#38383A",
    "text": { "color": "#8E8E93", "size": 13 }
  },


  "optionsMenu": {
    "background": "#1C1C1E",
    "border": { "color": "#3A3A3C", "radius": 8 },
    "header": {
      "color": "#8E8E93", "size": 11, "background": "#00000000",
      "padding": "12,6,12,4", "margin": "0,0,0,2"
    },
    "option": { "color": "#F2F2F7", "size": 13, "padding": "12,7", "cornerRadius": 6 },
    "optionSelected": { "background": "#0A84FF", "color": "#FFFFFF" }
  },

  "updateBanner": {
    "background": "#0A84FF",
    "text": { "color": "#FFFFFF", "size": 12 }
  },

  "preview": {
    "width": 400
  }
}
