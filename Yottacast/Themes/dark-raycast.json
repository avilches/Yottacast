{
  "id": "dark-raycast",
  "name": "Dark Raycast",
  "variant": "dark",

  "window": {
    "background": "#F01A1917",
    "width": 730,
    "cornerRadius": 12,
    "fontFamily": "SF Pro Text, Segoe UI, Inter"
  },

  "search": {
    "text":        { "color": "#F5F5F0", "size": 18, "fontFamily": "SF Pro Text, Segoe UI, Inter" },
    "placeholder": { "color": "#4A4A44" },
    "caret":       { "color": "#FF6B35" },
    "selection":   { "color": "#CC5228" },
    "hint":        { "color": "#FF3B30" }
  },

  "divider": { "color": "#28281F" },
  "spinner": { "color": "#6B6B64" },

  "results": {
    "background": "#0C0C0A",
    "cornerRadius": 8,
    "selectionBar": { "color": "#FF6B35", "width": 4 },
    "title":    { "color": "#F0F0EA", "size": 14 },
    "subtitle": { "color": "#5A5A52", "size": 12 },
    "category": { "color": "#606058", "size": 12 },
    "icon":     { "background": "#252520", "cornerRadius": 8 },
    "shortcut": { "color": "#5A5A52", "background": "#252520", "size": 12, "cornerRadius": 5 },
    "selection": {
      "background": "#FF6B35",
      "hoverBackground": "#FF7D4D",
      "color": "#FFFFFF",
      "iconBackground": "#30FFFFFF"
    },
    "hover": { "background": "#18FFFFFF" }
  },

  "calculator": {
    "fontFamily": "SF Pro Text, Segoe UI, Inter",
    "expression": { "color": "#F0F0EA", "size": 20, "fontWeight": "Medium" },
    "result":     { "color": "#F0F0EA", "size": 20, "fontWeight": "Medium" },
    "subtitle":   { "color": "#F0F0EA", "size": 13, "opacity": 0.55 },
    "separator":  { "color": "#F0F0EA" },
    "cell":       { "background": "#252520", "cornerRadius": 6 }
  },

  "converter": {
    "fontFamily": "SF Pro Text, Segoe UI, Inter",
    "value":    { "color": "#F0F0EA", "size": 20 },
    "subtitle": { "color": "#F0F0EA", "size": 13, "opacity": 0.55 },
    "arrow":    { "color": "#F0F0EA" },
    "hint":     { "color": "#5A5A52", "size": 12 },
    "cell":     { "cornerRadius": 6 }
  },

  "emoji": {
    "columns": 10,
    "viewportRows": 8,
    "cell":     { "size": 48, "cornerRadius": 8 },
    "char":     { "size": 28, "fontFamily": "Apple Color Emoji, Segoe UI Emoji, Noto Color Emoji" },
    "name":     { "color": "#F0F0EA", "size": 14 },
    "keywords": { "color": "#F0F0EA", "size": 12, "opacity": 0.55 },
    "sectionHeader": { "color": "#F0F0EA", "size": 11, "opacity": 0.5 },
    "favorite": { "color": "#FFD60A", "size": 8, "opacity": 0.7 },
    "usageCount": { "color": "#F0F0EA", "size": 9, "opacity": 0.4 }
  },

  "noResults": {
    "title":    { "color": "#4A4A44", "size": 16 },
    "subtitle": { "color": "#333330", "size": 14 }
  },

  "footer": {
    "background": "#1A1917",
    "border": "#252520",
    "text": { "color": "#7A7A72", "size": 13 }
  },

  "escBadge": {
    "background": "#252520",
    "cornerRadius": 6,
    "text": { "color": "#3A3A34", "size": 12 }
  },

  "updateBanner": {
    "background": "#FF6B35",
    "text": { "color": "#FFFFFF", "size": 12 }
  }
}
