{
  "id": "light-gray",
  "name": "Light Gray",
  "variant": "light",

  "window": {
    "background": "#F4F4F5",
    "width": 730,
    "cornerRadius": 14,
    "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter"
  },

  "search": {
    "background": "Transparent",
    "input": {
      "cornerRadius": 0,
      "margin": "0",
      "padding": "18,0",
      "border": { "color": "Transparent", "thickness": "0" }
    },
    "text":        { "color": "#111827", "size": 18, "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter" },
    "placeholder": { "color": "#9CA3AF" },
    "caret":       { "color": "#6B7280" },
    "selection":   { "color": "#D1D5DB" },
    "hint": {
      "error": {
        "color": "#FFFFFF", "size": 11, "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter",
        "padding": "6,2,6,3", "background": "#FF8888", "cornerRadius": 5, "textAlignment": "center", "horizontalAlignment": "center", "margin": "28,0,28,-8"
      },
      "info": {
        "color": "#9CA3AF", "size": 11, "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter",
        "padding": "0", "background": "Transparent", "cornerRadius": 0, "textAlignment": "left", "horizontalAlignment": "stretch", "margin": "28,0,28,0"
      }
    }
  },

  "groups": {
    "height": 24,
    "padding": "10,4",
    "margin": "0,0,6,0",
    "text": { "size": 12, "fontFamily": "SF Pro Text, Lucida Grande, Segoe UI, Inter" },
    "normal":   { "text": { "color": "#6B7280" }, "cornerRadius": 12, "border": { "color": "Transparent", "thickness": "0" } },
    "selected": { "text": { "color": "#111827" }, "cornerRadius": 12, "border": { "color": "#111827", "thickness": "1" } }
  },

  "divider": { "color": "#E5E7EB" },
  "spinner": { "color": "#9CA3AF" },

  "results": {
    "maxHeight": 540,
    "background": "#F8F9FA",
    "padding": 8,
    "cornerRadius": 8,
    "selectionBar": { "color": "#374151", "width": 4 },
    "title":    { "color": "#111827", "size": 14 },
    "subtitle": { "color": "#6B7280", "size": 12 },
    "category": { "color": "#9CA3AF", "size": 11 },
    "icon":     { "cornerRadius": 8 },
    "shortcut": { "color": "#6B7280", "background": "#E5E7EB", "size": 11, "cornerRadius": 5 },
    "selection": { "background": "#374151", "color": "#FFFFFF", "subtitleColor": "#CCFFFFFF" },
    "matchHighlight": {
      "color": "#111827",
      "background": "#FFFDE68A"
    }
  },

  "calculator": {
    "fontFamily": "avares://Yottacast/Assets/Fonts#Geist Mono, SF Mono, Menlo, Consolas, monospace",
    "expression": { "color": "#111827", "size": 20, "fontWeight": "Medium" },
    "result":     { "color": "#111827", "size": 20, "fontWeight": "Medium" },
    "subtitle":   { "color": "#111827", "size": 13, "opacity": 0.55 },
    "separator":  { "color": "#111827" },
    "cell":       { "cornerRadius": 6 }
  },

  "emoji": {
    "columns": 10,
    "cell":     { "size": 48, "cornerRadius": 8 },
    "char":     { "size": 28, "fontFamily": "Apple Color Emoji, Segoe UI Emoji, Noto Color Emoji" },
    "keywords": { "color": "#111827", "size": 11, "opacity": 0.55 },
    "sectionHeader": { "color": "#6B7280", "size": 11, "opacity": 0.7 },
    "favorite": { "color": "#EAB308", "size": 8, "opacity": 0.8 },
    "usageCount": { "color": "#6B7280", "size": 9, "opacity": 0.5 }
  },

  "noResults": {
    "title":    { "color": "#6B7280", "size": 16 },
    "subtitle": { "color": "#9CA3AF", "size": 14 }
  },

  "footer": {
    "background": "#F4F4F5",
    "border": "#D1D5DB",
    "text": { "color": "#6B7280", "size": 12 }
  },


  "optionsMenu": {
    "background": "#F4F4F5",
    "border": { "color": "#D1D5DB", "radius": 8 },
    "header": {
      "color": "#6B7280", "size": 11, "background": "#00000000",
      "padding": "12,6,12,4", "margin": "0,0,0,2"
    },
    "option": { "color": "#111827", "size": 13, "padding": "12,7", "cornerRadius": 6 },
    "optionSelected": { "background": "#374151", "color": "#FFFFFF" }
  },

  "updateBanner": {
    "background": "#374151",
    "text": { "color": "#FFFFFF", "size": 11 }
  },

  "preview": {
    "width": 400
  }
}
