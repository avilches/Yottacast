{
  "name": "Light Gray",
  "variant": "light",

  "window": {
    "background": "#F5F4F4F5",
    "width": 730,
    "cornerRadius": 14,
    "fontFamily": ""
  },

  "search": {
    "text":        { "color": "#111827", "size": 18, "fontFamily": "" },
    "placeholder": { "color": "#9CA3AF" },
    "caret":       { "color": "#6B7280" },
    "selection":   { "color": "#D1D5DB" },
    "hint":        { "color": "#D32F2F" }
  },

  "divider": { "color": "#E5E7EB" },
  "spinner": { "color": "#9CA3AF" },

  "results": {
    "cornerRadius": 8,
    "title":    { "color": "#111827", "size": 14 },
    "subtitle": { "color": "#6B7280", "size": 12 },
    "category": { "color": "#9CA3AF", "size": 11 },
    "icon":     { "background": "#F3F4F6", "cornerRadius": 8 },
    "shortcut": { "color": "#6B7280", "background": "#E5E7EB", "size": 11, "cornerRadius": 5 },
    "selection": {
      "background": "#374151",
      "hoverBackground": "#1F2937",
      "color": "#FFFFFF",
      "iconBackground": "#40FFFFFF"
    },
    "hover": { "background": "#10000000" }
  },

  "calculator": {
    "fontFamily": "",
    "expression": { "color": "#111827", "size": 20 },
    "result":     { "color": "#111827", "size": 20 },
    "subtitle":   { "color": "#111827", "size": 13, "opacity": 0.55 },
    "separator":  { "color": "#111827" },
    "cell":       { "background": "#F3F4F6", "cornerRadius": 6 }
  },

  "converter": {
    "fontFamily": "",
    "value":    { "color": "#111827", "size": 20 },
    "subtitle": { "color": "#111827", "size": 13, "opacity": 0.55 },
    "arrow":    { "color": "#111827" },
    "hint":     { "color": "#6B7280", "size": 12 },
    "cell":     { "cornerRadius": 6 }
  },

  "emoji": {
    "columns": 10,
    "viewportRows": 8,
    "cell":     { "size": 48, "cornerRadius": 8 },
    "char":     { "size": 28, "fontFamily": "Apple Color Emoji, Segoe UI Emoji, Noto Color Emoji" },
    "name":     { "color": "#111827", "size": 14 },
    "keywords": { "color": "#111827", "size": 11, "opacity": 0.55 },
    "sectionHeader": { "color": "#111827", "size": 11, "opacity": 0.5 }
  },

  "noResults": {
    "title":    { "color": "#6B7280", "size": 16 },
    "subtitle": { "color": "#9CA3AF", "size": 14 }
  },

  "footer": {
    "border": "#E5E7EB",
    "text": { "color": "#9CA3AF", "size": 11 }
  },

  "escBadge": {
    "background": "#F3F4F6",
    "cornerRadius": 6,
    "text": { "color": "#9CA3AF", "size": 11 }
  },

  "updateBanner": {
    "background": "#374151",
    "text": { "color": "#FFFFFF", "size": 11 }
  }
}
